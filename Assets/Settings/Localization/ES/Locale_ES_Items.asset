    Value: DA MEDIA DOSIS A
  - Key: item.half_dose.prompt
    Value: "SE\xD1ALA A QUIEN LE DAS MEDIA DOSIS"
  - Key: item.joker_card.name
    Value: Caja sorpresa
  - Key: item.joker_card.description
