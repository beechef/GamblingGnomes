  - Key: item.shared_roll.notice
    Value: TIRA CON
  - Key: item.shared_roll.prompt
    Value: "SE\xD1ALA A QUIEN TIRA CONTIGO"
  - Key: item.swap_board.name
    Value: Cigarro
  - Key: item.swap_board.description
    Value: Una carta boca abajo de la mesa se destapa para todos y se cambia por
