  - Key: item.extra_draw.notice
    Value: COMPROU UMA CARTA
  - Key: item.half_dose.name
    Value: Seringa
  - Key: item.half_dose.description
    Value: "Escolha um jogador: o n\xEDvel de alucina\xE7\xE3o dele \xE9 reduzido
