  - Key: item.pair_lock_items.notice
    Value: BLOQUEOU OS ITENS DE
  - Key: item.pair_lock.prompt
    Value: "APONTE PARA QUEM FICAR\xC1 BLOQUEADO COM VOC\xCA"
  - Key: item.peek_board.name
    Value: "Esp\xE1tula"
  - Key: item.peek_board.description
    Value: "Veja uma carta do board antes de ela ser revelada. Voc\xEA n\xE3o pode
