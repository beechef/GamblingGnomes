  - Key: item.rate_shift.raised
    Value: "+{0}% DE ALUCINA\xC7\xC3O PARA"
  - Key: item.rate_shift.lowered
    Value: "-{0}% DE ALUCINA\xC7\xC3O PARA"
  - Key: item.rate_shift.prompt
    Value: "APONTE PARA QUEM TER\xC1 A ALUCINA\xC7\xC3O ALTERADA"
  - Key: item.shared_roll.name
    Value: Cerveja
  - Key: item.shared_roll.description
    Value: "Voc\xEA e um jogador que escolher fazem uma Rolagem da Morte ao mesmo
      tempo, cada um com o pr\xF3prio n\xEDvel de alucina\xE7\xE3o."
  - Key: item.shared_roll.notice
    Value: FEZ UMA ROLAGEM DA MORTE COM
  - Key: item.shared_roll.prompt
    Value: "APONTE PARA QUEM FAR\xC1 UMA ROLAGEM DA MORTE COM VOC\xCA"
  - Key: item.swap_board.name
    Value: Cigarro
  - Key: item.swap_board.description
    Value: "Uma carta do board virada para baixo \xE9 revelada a todos e depois trocada
