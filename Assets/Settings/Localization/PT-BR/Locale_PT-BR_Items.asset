  - Key: item.mutual_reveal.notice
    Value: REVELA COM
  - Key: item.mutual_reveal.prompt_own
    Value: APONTE PARA A CARTA QUE VAI REVELAR
  - Key: item.mutual_reveal.prompt_player
    Value: "APONTE PARA QUEM REVELA UMA CARTA COM VOC\xCA"
  - Key: item.mutual_reveal.response
    Value: "QUER QUE VOC\xCA REVELE UMA CARTA: APONTE PARA UMA"
  - Key: item.pair_lock_fold.name
    Value: Algemas
  - Key: item.pair_lock_fold.description
    Value: "Voc\xEA e um jogador escolhido n\xE3o podem desistir na pr\xF3xima rodada."
  - Key: item.pair_lock_fold.notice
    Value: ALGEMOU
  - Key: item.pair_lock_items.name
    Value: Sem itens
  - Key: item.pair_lock_items.description
    Value: "Voc\xEA e um jogador escolhido n\xE3o podem usar itens na pr\xF3xima
