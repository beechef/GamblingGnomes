    Value: "REDUZIU PELA METADE A ALUCINA\xC7\xC3O DE"
  - Key: item.half_dose.prompt
    Value: "APONTE PARA QUEM TER\xC1 A ALUCINA\xC7\xC3O REDUZIDA PELA METADE"
  - Key: item.joker_card.name
    Value: Caixa de surpresa
  - Key: item.joker_card.description
    Value: "Uma carta sua \xE0 escolha tem {0}% de chance de virar Joker. S\xF3 voc\xEA
