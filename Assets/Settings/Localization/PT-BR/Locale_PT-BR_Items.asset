    Value: TENTOU COPIAR
  - Key: item.copy_card.copied
    Value: COPIADO
  - Key: item.copy_card.failed
    Value: "C\xD3PIA FALHOU"
  - Key: item.deck_count.name
    Value: Contador de naipes
  - Key: item.deck_count.description
    Value: "Veja quantas cartas de cada naipe restam no baralho, mais os Jokers,
