  - Key: item.swap_board.notice
    Value: TROCOU UMA CARTA DO BOARD
  - Key: item.swap_board.prompt
    Value: "APONTE PARA A CARTA QUE VAI P\xD4R NO BOARD"
  - Key: item.swap_hand.name
    Value: Faca
  - Key: item.swap_hand.description
    Value: "Troque uma das suas cartas com um jogador ainda na m\xE3o. Ele escolhe
