  - Key: item.joker_card.joker
    Value: CONSEGUIU UM JOKER
  - Key: item.joker_card.failed
    Value: SEM JOKER
  - Key: item.lock_fold.name
    Value: Cadeado
  - Key: item.lock_fold.description
    Value: "Ningu\xE9m pode desistir na pr\xF3xima rodada, incluindo voc\xEA."
  - Key: item.lock_fold.notice
    Value: "DESIST\xCANCIA BLOQUEADA"
  - Key: item.mushroom_dose.name
    Value: Batizada
  - Key: item.mushroom_dose.description
    Value: "Os pr\xF3ximos 2 cogumelos de um jogador escolhido n\xE3o fazem nada
