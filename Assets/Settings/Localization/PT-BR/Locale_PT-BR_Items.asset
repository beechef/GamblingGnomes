  - Key: item.place_on_board.notice
    Value: COLOCOU UMA CARTA
  - Key: item.place_on_board.prompt
    Value: APONTE PARA A CARTA QUE VAI COLOCAR NO BOARD
  - Key: item.raise_stakes.name
    Value: Aumentar aposta
  - Key: item.raise_stakes.description
    Value: "Toda aposta na pr\xF3xima rodada soma mais um cogumelo, incluindo a sua."
  - Key: item.raise_stakes.notice
    Value: APOSTAS AUMENTADAS
  - Key: item.random_suit.name
    Value: Dado
  - Key: item.random_suit.description
    Value: "Uma das suas cartas mant\xE9m o valor e muda para um naipe diferente
