  - Key: item.swap_hand.notice
    Value: TROCOU COM
  - Key: item.swap_hand.prompt_own
    Value: APONTE PARA A CARTA QUE VAI DAR
  - Key: item.swap_hand.prompt_player
    Value: APONTE PARA QUEM VAI TROCAR
  - Key: item.swap_hand.response
    Value: "quer trocar cartas com voc\xEA: escolha uma para dar"
  - Key: item.table_reveal.name
    Value: Megafone
  - Key: item.table_reveal.description
    Value: "Cada jogador ainda na m\xE3o revela uma carta aleat\xF3ria para todos
