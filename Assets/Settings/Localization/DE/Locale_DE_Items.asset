%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48cfa9c17f2bc884ba9c1aad02a042a1, type: 3}
  m_Name: Locale_DE_Items
  m_EditorClassIdentifier: Localization::Localization.LocaleSection
  _entries:
  - Key: item.prompt.player
    Value: ZEIGE AUF EINEN SPIELER
  - Key: item.prompt.opponent_card
    Value: ZEIGE AUF DIE KARTE EINES ANDEREN SPIELERS
  - Key: item.prompt.own_card
    Value: ZEIGE AUF EINE DEINER KARTEN
  - Key: item.prompt.board_card
    Value: ZEIGE AUF EINE VERDECKTE BOARDKARTE
  - Key: item.reason.not_dealt
    Value: "Dieses Item ist in dieser Partie nicht verf\xFCgbar."
  - Key: item.reason.not_held
    Value: Du hast dieses Item nicht.
  - Key: item.reason.out_of_match
    Value: Du bist aus dieser Partie raus.
  - Key: item.reason.street_only
    Value: "Nur w\xE4hrend einer Setzrunde."
  - Key: item.reason.turn_only
    Value: Nur wenn du dran bist.
  - Key: item.reason.locked_out
    Value: Items sind in dieser Runde gesperrt.
  - Key: item.reason.used_one
    Value: Du hast in dieser Runde bereits ein Item benutzt.
  - Key: item.reason.used_many
    Value: Du hast in dieser Runde bereits {0} Items benutzt.
  - Key: item.reason.waiting_other
    Value: Warte darauf, dass ein anderes Item abgeschlossen wird.
  - Key: item.reason.not_in_hand
    Value: Du bist in dieser Hand nicht dabei.
  - Key: item.reason.hand_full
    Value: Deine Item-Slots sind voll.
  - Key: item.reason.deck_empty
    Value: Das Deck ist leer.
  - Key: item.reason.no_street_left
    Value: "In dieser Hand ist keine Runde mehr \xFCbrig."
  - Key: item.reason.no_board
    Value: In dieser Partie gibt es kein Board.
  - Key: item.reason.last_board_seen
    Value: Du hast die letzte Boardkarte schon gesehen.
  - Key: item.reason.board_seen
    Value: Du hast alle Boardkarten schon gesehen.
  - Key: item.reason.board_full
    Value: Das Board ist voll.
  - Key: item.reason.no_card_to_lay
    Value: Du hast keine Karte zum Ablegen.
  - Key: item.reason.no_card_to_give
    Value: Du hast keine Karte mehr zum Abgeben.
  - Key: item.reason.all_face_up
    Value: Alle Karten sind schon aufgedeckt.
  - Key: item.reason.cant_change
    Value: "Keine deiner Karten kann ver\xE4ndert werden."
  - Key: item.reason.already_under
    Value: "Du hast bereits eine \xDCberdosis erlitten."
  - Key: item.reason.nobody_to_halve
    Value: "Niemand hat eine Halluzinationsrate, die sich halbieren l\xE4sst."
  - Key: item.reason.nobody_in_hand
    Value: Niemand sonst ist noch in der Hand.
  - Key: item.reason.nobody_to_shake
    Value: "Es ist niemand mehr als Ziel \xFCbrig."
  - Key: item.reason.nobody_to_roll
    Value: "Niemand sonst ist noch f\xFCr einen Todeswurf \xFCbrig."
  - Key: item.reason.nobody_to_swap
    Value: Niemand sonst hat eine Karte zum Tauschen.
  - Key: item.copy_card.name
    Value: Kopie
  - Key: item.copy_card.description
    Value: 35 % Chance, dass eine deiner Karten zur Kopie einer anderen deiner Karten
      wird.
  - Key: item.copy_card.notice
    Value: VERSUCHT ZU KOPIEREN
  - Key: item.copy_card.copied
    Value: KOPIERT
  - Key: item.copy_card.failed
    Value: KOPIE FEHLGESCHLAGEN
  - Key: item.deck_count.name
    Value: "Farbenz\xE4hler"
  - Key: item.deck_count.description
    Value: "Sieh, wie viele Karten jeder Farbe noch im Deck sind, plus Joker, falls
      das Deck welche enth\xE4lt. Nur du siehst die Z\xE4hlung, und du beh\xE4ltst
      sie bis zum Ende der Hand."
  - Key: item.deck_count.notice
    Value: "HAT DAS DECK GEZ\xC4HLT"
  - Key: item.extra_draw.name
    Value: Kotze
  - Key: item.extra_draw.description
    Value: "Ziehe eine weitere Karte vom Deck. Du kannst f\xFCr den Rest dieser Hand
      nicht folden."
  - Key: item.extra_draw.notice
    Value: HAT EINE KARTE GEZOGEN
  - Key: item.half_dose.name
    Value: Spritze
  - Key: item.half_dose.description
    Value: "W\xE4hle einen Spieler: Seine Halluzinationsrate wird dauerhaft halbiert,
      dann macht er einen Todeswurf."
  - Key: item.half_dose.notice
    Value: HAT DIE HALLUZINATION HALBIERT VON
  - Key: item.half_dose.prompt
    Value: ZEIGE AUF DEN SPIELER, DESSEN HALLUZINATION DU HALBIERST
  - Key: item.joker_card.name
    Value: Springteufel
  - Key: item.joker_card.description
    Value: "Eine Karte deiner Wahl wird mit {0} % Wahrscheinlichkeit zum Joker. Nur
      du erf\xE4hrst das Ergebnis."
  - Key: item.joker_card.joker
    Value: HAT EINEN JOKER BEKOMMEN
  - Key: item.joker_card.failed
    Value: KEIN JOKER
  - Key: item.lock_fold.name
    Value: Schloss
  - Key: item.lock_fold.description
    Value: "Niemand kann in der n\xE4chsten Runde folden, du eingeschlossen."
  - Key: item.lock_fold.notice
    Value: FOLDEN GESPERRT
  - Key: item.mushroom_dose.name
    Value: Panscherei
  - Key: item.mushroom_dose.description
    Value: "Die n\xE4chsten 2 Pilze eines gew\xE4hlten Spielers haben entweder keine
      Wirkung oder wirken doppelt so stark, 50/50."
  - Key: item.mushroom_dose.notice
    Value: HAT GEPANSCHT BEI
  - Key: item.mushroom_dose.prompt
    Value: ZEIGE AUF DEN SPIELER, DESSEN PILZE DU PANSCHST
  - Key: item.mutual_reveal.name
    Value: Gemeinsam aufdecken
  - Key: item.mutual_reveal.description
    Value: "Du und ein von dir gew\xE4hlter Spieler deckt jeweils eine Karte auf.
      Sie bleibt bis zum Ende der Hand f\xFCr alle sichtbar. Der andere Spieler w\xE4hlt
      selbst, welche."
  - Key: item.mutual_reveal.notice
    Value: DECKT AUF MIT
  - Key: item.mutual_reveal.prompt_own
    Value: ZEIGE AUF DIE KARTE, DIE DU AUFDECKST
  - Key: item.mutual_reveal.prompt_player
    Value: ZEIGE AUF DEN SPIELER, DER MIT DIR AUFDECKT
  - Key: item.mutual_reveal.response
    Value: 'WILL, DASS DU EINE KARTE AUFDECKST: ZEIGE AUF EINE'
  - Key: item.pair_lock_fold.name
    Value: Handschellen
  - Key: item.pair_lock_fold.description
    Value: "Du und ein gew\xE4hlter Spieler k\xF6nnt in der n\xE4chsten Runde nicht
      folden."
  - Key: item.pair_lock_fold.notice
    Value: FESSELT
  - Key: item.pair_lock_items.name
    Value: Keine Items
  - Key: item.pair_lock_items.description
    Value: "Du und ein gew\xE4hlter Spieler k\xF6nnt in der n\xE4chsten Runde keine
      Items benutzen."
  - Key: item.pair_lock_items.notice
    Value: HAT DIE ITEMS GESPERRT VON
  - Key: item.pair_lock.prompt
    Value: ZEIGE AUF DEN SPIELER, DER MIT DIR GESPERRT WIRD
  - Key: item.peek_board.name
    Value: Pfannenwender
  - Key: item.peek_board.description
    Value: Sieh dir eine Boardkarte an, bevor sie aufgedeckt wird. In dieser Runde
      kannst du nicht folden.
  - Key: item.peek_board.notice
    Value: "HAT INS BOARD GESP\xC4HT"
  - Key: item.peek_board_main.description
    Value: Sieh dir die letzte Boardkarte an, bevor sie aufgedeckt wird. In dieser
      Runde kannst du nicht folden.
  - Key: item.peek_hand.name
    Value: "Sp\xE4hen"
  - Key: item.peek_hand.description
    Value: "Sieh dir eine Karte eines Spielers an, der noch in der Hand ist. Er erf\xE4hrt,
      welche Karte du gesehen hast."
  - Key: item.peek_hand.notice
    Value: "HAT GESP\xC4HT BEI"
  - Key: item.place_on_board.name
    Value: Zigarette
  - Key: item.place_on_board.description
    Value: Lege eine deiner Karten aufgedeckt aufs Board, sodass alle sie sehen,
      und ziehe stattdessen eine neue Karte vom Deck.
  - Key: item.place_on_board.notice
    Value: HAT EINE KARTE ABGELEGT
  - Key: item.place_on_board.prompt
    Value: ZEIGE AUF DIE KARTE, DIE DU AUFS BOARD LEGST
  - Key: item.raise_stakes.name
    Value: "Erh\xF6hen"
  - Key: item.raise_stakes.description
    Value: "Jeder Einsatz in der n\xE4chsten Runde erh\xF6ht sich um einen Pilz,
      deiner eingeschlossen."
  - Key: item.raise_stakes.notice
    Value: "EINS\xC4TZE ERH\xD6HT"
  - Key: item.random_suit.name
    Value: "W\xFCrfel"
  - Key: item.random_suit.description
    Value: "Eine deiner Karten beh\xE4lt ihren Wert und nimmt eine zuf\xE4llige andere
      Farbe an."
  - Key: item.random_suit.notice
    Value: "FARBE GE\xC4NDERT"
  - Key: item.random_suit.prompt
    Value: "ZEIGE AUF DIE KARTE, DIE GE\xC4NDERT WERDEN SOLL"
  - Key: item.rate_shift.name
    Value: Slip
  - Key: item.rate_shift.description
    Value: "W\xE4hle einen Spieler: Seine Halluzinationsrate steigt oder sinkt zuf\xE4llig
      um {0} %."
  - Key: item.rate_shift.raised
    Value: "+{0} % HALLUZINATION F\xDCR"
  - Key: item.rate_shift.lowered
    Value: "-{0} % HALLUZINATION F\xDCR"
  - Key: item.rate_shift.prompt
    Value: "ZEIGE AUF DEN SPIELER, DESSEN HALLUZINATION DU VER\xC4NDERST"
  - Key: item.shared_roll.name
    Value: Bier
  - Key: item.shared_roll.description
    Value: "Du und ein gew\xE4hlter Spieler macht gleichzeitig jeweils einen Todeswurf,
      basierend auf eurer eigenen Halluzinationsrate."
  - Key: item.shared_roll.notice
    Value: HAT EINEN TODESWURF GEMACHT MIT
  - Key: item.shared_roll.prompt
    Value: ZEIGE AUF DEN SPIELER, DER MIT DIR EINEN TODESWURF MACHT
  - Key: item.swap_board.name
    Value: Zigarette
  - Key: item.swap_board.description
    Value: "Eine verdeckte Boardkarte wird f\xFCr alle aufgedeckt und dann gegen
      eine deiner Karten getauscht. Deine Karte bleibt aufgedeckt auf dem Board liegen."
  - Key: item.swap_board.notice
    Value: HAT EINE BOARDKARTE GETAUSCHT
  - Key: item.swap_board.prompt
    Value: ZEIGE AUF DIE KARTE, DIE DU AUFS BOARD LEGST
  - Key: item.swap_hand.name
    Value: Messer
  - Key: item.swap_hand.description
    Value: "Tausche eine deiner Karten mit einem Spieler, der noch in der Hand ist.
      Er w\xE4hlt, welche seiner Karten er gibt."
  - Key: item.swap_hand.notice
    Value: HAT GETAUSCHT MIT
  - Key: item.swap_hand.prompt_own
    Value: ZEIGE AUF DIE KARTE, DIE DU GIBST
  - Key: item.swap_hand.prompt_player
    Value: ZEIGE AUF DEN SPIELER, MIT DEM DU TAUSCHST
  - Key: item.swap_hand.response
    Value: "will Karten mit dir tauschen: w\xE4hle eine zum Geben"
  - Key: item.table_reveal.name
    Value: Megafon
  - Key: item.table_reveal.description
    Value: "Jeder Spieler, der noch in der Hand ist, deckt in dieser Runde eine zuf\xE4llige
      Karte f\xFCr alle auf."
  - Key: item.table_reveal.notice
    Value: HAT ALLE ZUM AUFDECKEN GEZWUNGEN
  - Key: item.reason.no_time
    Value: Es bleibt nicht genug Zeit, damit er antworten kann.
