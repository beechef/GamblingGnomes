  - Key: item.swap_hand.notice
    Value: TUKAR KARTU DENGAN
  - Key: item.swap_hand.prompt_own
    Value: TUNJUK KARTU YANG KAMU BERIKAN
  - Key: item.swap_hand.prompt_player
    Value: TUNJUK SIAPA YANG DIAJAK TUKAR
  - Key: item.swap_hand.response
    Value: menukar kartu denganmu - pilih satu untuk ditukar
  - Key: item.table_reveal.name
    Value: Megafon
  - Key: item.table_reveal.description
    Value: Setiap pemain yang masih ikut membuka satu kartu acak ke seluruh meja
      di ronde ini.
  - Key: item.table_reveal.notice
    Value: MEMBONGKAR SEMUA
  - Key: item.reason.no_time
    Value: Waktu tidak cukup untuk mereka menjawab.
