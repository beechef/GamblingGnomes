  m_Name: Locale_ID_Items
  m_EditorClassIdentifier: Localization::Localization.LocaleSection
  _entries:
  - Key: item.prompt.player
    Value: ARAHKAN KE SEORANG PEMAIN
  - Key: item.prompt.opponent_card
    Value: ARAHKAN KE KARTU PEMAIN LAIN
  - Key: item.prompt.own_card
    Value: ARAHKAN KE SALAH SATU KARTUMU
  - Key: item.prompt.board_card
    Value: ARAHKAN KE KARTU BOARD YANG TERTUTUP
  - Key: item.reason.not_dealt
    Value: Item ini tidak tersedia di match ini.
  - Key: item.reason.not_held
    Value: Kamu tidak punya item ini.
  - Key: item.reason.out_of_match
    Value: Kamu sudah tersingkir dari match ini.
  - Key: item.reason.street_only
    Value: Hanya saat ronde taruhan.
  - Key: item.reason.turn_only
    Value: Hanya saat giliranmu.
  - Key: item.reason.locked_out
    Value: Item terkunci di ronde ini.
  - Key: item.reason.used_one
    Value: Kamu sudah menggunakan item di ronde ini.
  - Key: item.reason.used_many
    Value: Kamu sudah menggunakan {0} item di ronde ini.
  - Key: item.reason.waiting_other
    Value: Menunggu item lain selesai.
  - Key: item.reason.not_in_hand
    Value: Kamu tidak ikut di hand ini.
  - Key: item.reason.hand_full
    Value: Slot item kamu penuh.
  - Key: item.reason.deck_empty
    Value: Deck kosong.
  - Key: item.reason.no_street_left
    Value: Tidak ada ronde tersisa di hand ini.
  - Key: item.reason.no_board
    Value: Tidak ada board di match ini.
  - Key: item.reason.last_board_seen
    Value: Kamu sudah melihat kartu board terakhir.
  - Key: item.reason.board_seen
    Value: Kamu sudah melihat semua kartu board.
  - Key: item.reason.board_full
    Value: Board sudah penuh.
  - Key: item.reason.no_card_to_lay
    Value: Kamu tidak punya kartu untuk ditaruh.
  - Key: item.reason.no_card_to_give
    Value: Kamu tidak punya kartu lagi untuk diberikan.
  - Key: item.reason.all_face_up
    Value: Semua kartu sudah terbuka.
  - Key: item.reason.cant_change
    Value: Tidak ada kartumu yang bisa diubah.
  - Key: item.reason.already_under
    Value: Kamu sudah overdosis.
  - Key: item.reason.nobody_to_halve
    Value: Tidak ada yang punya tingkat halusinasi untuk dibagi dua.
  - Key: item.reason.nobody_in_hand
    Value: Tidak ada pemain lain yang tersisa di hand ini.
  - Key: item.reason.nobody_to_shake
    Value: Tidak ada lagi yang bisa dijadikan target.
  - Key: item.reason.nobody_to_roll
    Value: Tidak ada pemain lain untuk Death Roll.
  - Key: item.reason.nobody_to_swap
    Value: Tidak ada pemain lain yang punya kartu untuk ditukar.
  - Key: item.copy_card.name
    Value: Salin
  - Key: item.copy_card.description
    Value: Peluang 35% salah satu kartumu menjadi salinan kartumu yang lain.
  - Key: item.copy_card.notice
    Value: MENCOBA MENYALIN
  - Key: item.copy_card.copied
    Value: BERHASIL DISALIN
  - Key: item.copy_card.failed
    Value: GAGAL MENYALIN
  - Key: item.deck_count.name
    Value: Hitung Corak
  - Key: item.deck_count.description
    Value: Lihat berapa kartu dari setiap corak yang tersisa di deck, ditambah Joker
      jika ada. Hanya kamu yang melihat hitungannya, dan hitungan itu bertahan sampai
      hand berakhir.
  - Key: item.deck_count.notice
    Value: MENGHITUNG DECK
  - Key: item.extra_draw.name
    Value: Muntahan
  - Key: item.extra_draw.description
    Value: Ambil satu kartu lagi dari deck. Kamu tidak bisa Fold selama sisa hand
      ini.
  - Key: item.extra_draw.notice
    Value: MENGAMBIL KARTU
  - Key: item.half_dose.name
    Value: Suntikan
  - Key: item.half_dose.description
    Value: 'Pilih seorang pemain: tingkat halusinasinya dibagi dua secara permanen,
      lalu ia melakukan Death Roll.'
  - Key: item.half_dose.notice
    Value: MEMBAGI DUA TINGKAT HALUSINASI MILIK
  - Key: item.half_dose.prompt
    Value: ARAHKAN KE PEMAIN YANG TINGKAT HALUSINASINYA DIBAGI DUA
  - Key: item.joker_card.name
    Value: Kotak Kejutan
  - Key: item.joker_card.description
    Value: Satu kartumu yang dipilih punya peluang {0}% menjadi Joker. Hanya kamu
      yang tahu hasilnya.
  - Key: item.joker_card.joker
    Value: DAPAT JOKER
  - Key: item.joker_card.failed
    Value: TIDAK ADA JOKER
  - Key: item.lock_fold.name
    Value: Kunci
  - Key: item.lock_fold.description
    Value: Tidak ada yang bisa Fold di ronde berikutnya, termasuk kamu.
  - Key: item.lock_fold.notice
    Value: FOLD DIKUNCI
  - Key: item.mushroom_dose.name
    Value: Oplos
  - Key: item.mushroom_dose.description
    Value: 2 jamur berikutnya dari pemain yang dipilih bisa tidak berefek apa-apa
      atau berefek dua kali lipat, 50/50.
  - Key: item.mushroom_dose.notice
    Value: MENGOPLOS
  - Key: item.mushroom_dose.prompt
    Value: ARAHKAN KE PEMAIN YANG JAMURNYA AKAN DIOPLOS
  - Key: item.mutual_reveal.name
    Value: Buka Bersama
  - Key: item.mutual_reveal.description
    Value: Kamu dan pemain yang kamu pilih masing-masing membuka satu kartu, terbuka
      untuk semua orang sampai hand berakhir. Dia memilih sendiri kartu yang mana.
  - Key: item.mutual_reveal.notice
    Value: MEMBUKA BERSAMA
  - Key: item.mutual_reveal.prompt_own
    Value: ARAHKAN KE KARTU YANG AKAN KAMU BUKA
  - Key: item.mutual_reveal.prompt_player
    Value: ARAHKAN KE PEMAIN YANG MEMBUKA KARTU BERSAMAMU
  - Key: item.mutual_reveal.response
    Value: 'MENGINGINKANMU MEMBUKA SATU KARTU: ARAHKAN KE SATU'
  - Key: item.pair_lock_fold.name
    Value: Borgol
  - Key: item.pair_lock_fold.description
    Value: Kamu dan pemain yang dipilih tidak bisa Fold di ronde berikutnya.
  - Key: item.pair_lock_fold.notice
    Value: MEMBORGOL
  - Key: item.pair_lock_items.name
    Value: Tanpa Item
  - Key: item.pair_lock_items.description
    Value: Kamu dan pemain yang dipilih tidak bisa menggunakan item di ronde berikutnya.
  - Key: item.pair_lock_items.notice
    Value: MEMBLOKIR ITEM MILIK
  - Key: item.pair_lock.prompt
    Value: ARAHKAN KE PEMAIN YANG TERKUNCI BERSAMAMU
  - Key: item.peek_board.name
    Value: Spatula
  - Key: item.peek_board.description
    Value: Lihat satu kartu board sebelum dibuka. Kamu tidak bisa Fold di ronde ini.
  - Key: item.peek_board.notice
    Value: MENGINTIP BOARD
  - Key: item.peek_board_main.description
    Value: Lihat kartu board terakhir sebelum dibuka. Kamu tidak bisa Fold di ronde
      ini.
  - Key: item.peek_hand.name
    Value: Intip
  - Key: item.peek_hand.description
    Value: Lihat satu kartu milik pemain yang masih ada di hand ini. Dia diberi tahu
      kartu mana yang kamu lihat.
  - Key: item.peek_hand.notice
    Value: MENGINTIP
  - Key: item.place_on_board.name
    Value: Rokok
  - Key: item.place_on_board.description
    Value: Taruh satu kartumu terbuka di board agar semua orang bisa melihatnya,
      lalu ambil kartu baru dari deck sebagai gantinya.
  - Key: item.place_on_board.notice
    Value: MENARUH KARTU
  - Key: item.place_on_board.prompt
    Value: ARAHKAN KE KARTU YANG AKAN KAMU TARUH DI BOARD
  - Key: item.raise_stakes.name
    Value: Raise
  - Key: item.raise_stakes.description
    Value: Setiap taruhan di ronde berikutnya bertambah satu jamur, termasuk milikmu.
  - Key: item.raise_stakes.notice
    Value: TARUHAN DINAIKKAN
  - Key: item.random_suit.name
    Value: Dadu
  - Key: item.random_suit.description
    Value: Satu kartumu mempertahankan nilainya dan berganti ke corak lain secara
      acak.
  - Key: item.random_suit.notice
    Value: MENGUBAH CORAK
  - Key: item.random_suit.prompt
    Value: ARAHKAN KE KARTU YANG AKAN DIUBAH
  - Key: item.rate_shift.name
    Value: Celana Dalam
  - Key: item.rate_shift.description
    Value: 'Pilih seorang pemain: tingkat halusinasinya naik atau turun {0}% secara
      acak.'
  - Key: item.rate_shift.raised
    Value: +{0}% HALUSINASI UNTUK
  - Key: item.rate_shift.lowered
    Value: -{0}% HALUSINASI UNTUK
  - Key: item.rate_shift.prompt
    Value: ARAHKAN KE PEMAIN YANG TINGKAT HALUSINASINYA AKAN DIUBAH
  - Key: item.shared_roll.name
    Value: Bir
  - Key: item.shared_roll.description
    Value: Kamu dan pemain yang kamu pilih melakukan Death Roll secara bersamaan,
      masing-masing sesuai tingkat halusinasinya sendiri.
  - Key: item.shared_roll.notice
    Value: MELAKUKAN DEATH ROLL BERSAMA
  - Key: item.shared_roll.prompt
    Value: ARAHKAN KE PEMAIN YANG MELAKUKAN DEATH ROLL BERSAMAMU
  - Key: item.swap_board.name
    Value: Rokok
  - Key: item.swap_board.description
    Value: Satu kartu board yang tertutup dibuka untuk semua orang, lalu ditukar
      dengan salah satu kartumu. Kartumu tetap terbuka di board.
  - Key: item.swap_board.notice
    Value: MENUKAR KARTU BOARD
  - Key: item.swap_board.prompt
    Value: ARAHKAN KE KARTU YANG AKAN KAMU TARUH DI BOARD
  - Key: item.swap_hand.name
    Value: Pisau
  - Key: item.swap_hand.description
    Value: Tukar satu kartumu dengan pemain yang masih ada di hand ini. Dia memilih
      sendiri kartu mana yang diberikan.
  - Key: item.swap_hand.notice
    Value: MENUKAR DENGAN
  - Key: item.swap_hand.prompt_own
    Value: ARAHKAN KE KARTU YANG AKAN KAMU BERIKAN
  - Key: item.swap_hand.prompt_player
    Value: ARAHKAN KE PEMAIN YANG AKAN KAMU TUKAR KARTUNYA
  - Key: item.swap_hand.response
    Value: 'ingin bertukar kartu denganmu: pilih satu untuk diberikan'
  - Key: item.table_reveal.name
    Value: Megafon
  - Key: item.table_reveal.description
    Value: Setiap pemain yang masih ada di hand ini membuka satu kartu acak untuk
      semua orang di ronde ini.
  - Key: item.table_reveal.notice
    Value: MEMBUAT SEMUA ORANG MEMBUKA KARTU
  - Key: item.reason.no_time
    Value: Waktu tidak cukup untuk dia menjawab.
