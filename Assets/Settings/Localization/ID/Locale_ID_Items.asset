  - Key: item.joker_card.joker
    Value: DAPAT JOKER
  - Key: item.joker_card.failed
    Value: TIDAK DAPAT JOKER
  - Key: item.lock_fold.name
    Value: Kunci
  - Key: item.lock_fold.description
    Value: Tidak ada yang bisa fold di ronde berikutnya, termasuk kamu.
  - Key: item.lock_fold.notice
    Value: MENGUNCI FOLD
  - Key: item.mushroom_dose.name
    Value: Oplos
  - Key: item.mushroom_dose.description
    Value: 2 jamur berikutnya milik pemain pilihan tidak berefek atau berefek dua
