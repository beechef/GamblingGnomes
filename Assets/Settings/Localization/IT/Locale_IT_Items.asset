    Value: HA BLOCCATO GLI OGGETTI DI
  - Key: item.pair_lock.prompt
    Value: "PUNTA CHI SAR\xC0 BLOCCATO CON TE"
  - Key: item.peek_board.name
    Value: Spatola
  - Key: item.peek_board.description
    Value: Vedi una carta del board prima che venga rivelata. Non puoi fare Fold
