  - Key: item.shared_roll.notice
    Value: HA FATTO UN TIRO DELLA MORTE CON
  - Key: item.shared_roll.prompt
    Value: PUNTA CHI FA UN TIRO DELLA MORTE CON TE
  - Key: item.swap_board.name
    Value: Sigaretta
  - Key: item.swap_board.description
    Value: Una carta del board coperta viene rivelata a tutti, poi scambiata con
