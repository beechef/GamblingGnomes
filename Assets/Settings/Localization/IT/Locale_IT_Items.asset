  - Key: item.deck_count.notice
    Value: HA CONTATO IL MAZZO
  - Key: item.extra_draw.name
    Value: Vomito
  - Key: item.extra_draw.description
    Value: "Pesca una carta in pi\xF9 dal mazzo. Non puoi fare Fold per il resto
