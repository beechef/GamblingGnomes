  - Key: item.copy_card.failed
    Value: COPIA FALLITA
  - Key: item.deck_count.name
    Value: Conta semi
  - Key: item.deck_count.description
    Value: "Vedi quante carte di ogni seme restano nel mazzo, pi\xF9 i Joker se ce
