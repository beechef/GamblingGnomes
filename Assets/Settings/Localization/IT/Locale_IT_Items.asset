    Value: HA BLOCCATO GLI OGGETTI DI
  - Key: item.pair_lock.prompt
    Value: INDICA CHI VIENE BLOCCATO CON TE
  - Key: item.peek_board.name
    Value: Spatola
  - Key: item.peek_board.description
    Value: Guarda una carta comune prima che venga girata. Non puoi lasciare in questo
