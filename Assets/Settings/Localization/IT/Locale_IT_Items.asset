  - Key: item.extra_draw.notice
    Value: HA PESCATO UNA CARTA
  - Key: item.half_dose.name
    Value: Siringa
  - Key: item.half_dose.description
    Value: 'Scegli un giocatore: il suo livello di allucinazione viene dimezzato
