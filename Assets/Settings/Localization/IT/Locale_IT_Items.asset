  - Key: item.rate_shift.prompt
    Value: PUNTA DI CHI CAMBIARE L'ALLUCINAZIONE
  - Key: item.shared_roll.name
    Value: Birra
  - Key: item.shared_roll.description
    Value: Tu e un giocatore a tua scelta effettuate ciascuno un Tiro della morte
