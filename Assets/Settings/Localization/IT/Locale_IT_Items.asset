  - Key: item.swap_board.notice
    Value: HA SCAMBIATO UNA CARTA DEL BOARD
  - Key: item.swap_board.prompt
    Value: PUNTA LA CARTA CHE METTI SUL BOARD
  - Key: item.swap_hand.name
    Value: Coltello
  - Key: item.swap_hand.description
    Value: Scambia una delle tue carte con un giocatore ancora in mano. Lui sceglie
