  - Key: item.place_on_board.notice
    Value: HA POSATO UNA CARTA
  - Key: item.place_on_board.prompt
    Value: PUNTA LA CARTA DA POSARE SUL BOARD
  - Key: item.raise_stakes.name
    Value: Rilancio
  - Key: item.raise_stakes.description
    Value: "Ogni puntata del prossimo giro aggiunge un fungo in pi\xF9, la tua compresa."
