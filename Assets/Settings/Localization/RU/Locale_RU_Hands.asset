  m_Script: {fileID: 11500000, guid: 48cfa9c17f2bc884ba9c1aad02a042a1, type: 3}
  m_Name: Locale_RU_Hands
  m_EditorClassIdentifier: Localization::Localization.LocaleSection
  _entries:
  - Key: hand.five_of_a_kind.name
    Value: "\u041F\u044F\u0442\u0451\u0440\u043A\u0430"
  - Key: hand.five_of_a_kind.description
    Value: "\u041F\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430. \u0411\u044B\u0432\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0434\u0436\u043E\u043A\u0435\u0440\u0430\u043C\u0438."
  - Key: hand.royal_flush.name
    Value: "\u0420\u043E\u044F\u043B-\u0444\u043B\u0435\u0448"
  - Key: hand.royal_flush.description
    Value: "\u0422\u0443\u0437, \u043A\u043E\u0440\u043E\u043B\u044C, \u0434\u0430\u043C\u0430,
      \u0432\u0430\u043B\u0435\u0442 \u0438 \u0434\u0435\u0441\u044F\u0442\u043A\u0430
      \u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0441\u0442\u0438."
  - Key: hand.straight_flush.name
    Value: "\u0421\u0442\u0440\u0438\u0442-\u0444\u043B\u0435\u0448"
  - Key: hand.straight_flush.description
    Value: "\u041F\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043F\u043E\u0434\u0440\u044F\u0434
      \u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0441\u0442\u0438."
  - Key: hand.four_of_a_kind.name
    Value: "\u041A\u0430\u0440\u0435"
  - Key: hand.four_of_a_kind.description
    Value: "\u0427\u0435\u0442\u044B\u0440\u0435 \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430."
  - Key: hand.full_house.name
    Value: "\u0424\u0443\u043B\u043B-\u0445\u0430\u0443\u0441"
  - Key: hand.full_house.description
    Value: "\u0422\u0440\u0438 \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430 \u0438 \u0434\u0432\u0435
      \u043A\u0430\u0440\u0442\u044B \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
  - Key: hand.flush.name
    Value: "\u0424\u043B\u0435\u0448"
  - Key: hand.flush.description
    Value: "\u041F\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u043E\u0439
      \u043C\u0430\u0441\u0442\u0438."
  - Key: hand.straight.name
    Value: "\u0421\u0442\u0440\u0438\u0442"
  - Key: hand.straight.description
    Value: "\u041F\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043F\u043E\u0434\u0440\u044F\u0434."
  - Key: hand.three_of_a_kind.name
    Value: "\u0422\u0440\u043E\u0439\u043A\u0430"
  - Key: hand.three_of_a_kind.description
    Value: "\u0422\u0440\u0438 \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430."
  - Key: hand.two_pair.name
    Value: "\u0414\u0432\u0435 \u043F\u0430\u0440\u044B"
  - Key: hand.two_pair.description
    Value: "\u0414\u0432\u0435 \u043F\u0430\u0440\u044B \u043A\u0430\u0440\u0442
      \u0440\u0430\u0437\u043D\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430."
  - Key: hand.pair.name
    Value: "\u041F\u0430\u0440\u0430"
  - Key: hand.pair.description
    Value: "\u0414\u0432\u0435 \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430."
  - Key: hand.high_card.name
    Value: "\u0421\u0442\u0430\u0440\u0448\u0430\u044F \u043A\u0430\u0440\u0442\u0430"
  - Key: hand.high_card.description
    Value: "\u041F\u044F\u0442\u044C \u0440\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u043D\u044B\u0445
      \u043A\u0430\u0440\u0442, \u043D\u0435 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438."
