  - Key: item.swap_board.name
    Value: "\u0421\u0438\u0433\u0430\u0440\u0435\u0442\u0430"
  - Key: item.swap_board.description
    Value: "\u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F \u043E\u0431\u0449\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u0432\u0441\u0435\u0445, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 \u043E\u0434\u043D\u0443
      \u0438\u0437 \u0442\u0432\u043E\u0438\u0445 \u043A\u0430\u0440\u0442, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
  - Key: item.swap_board.notice
    Value: "\u041C\u0415\u041D\u042F\u0415\u0422\u0421\u042F \u0421\u041E \u0421\u0422\u041E\u041B\u041E\u041C"
  - Key: item.swap_board.prompt
    Value: "\u0423\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u041A\u041E\u0422\u041E\u0420\u0423\u042E
