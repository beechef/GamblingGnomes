  - Key: item.peek_board.name
    Value: "\u041B\u043E\u043F\u0430\u0442\u043A\u0430"
  - Key: item.peek_board.description
    Value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043E\u0434\u043D\u0443
      \u043E\u0431\u0449\u0443\u044E \u043A\u0430\u0440\u0442\u0443 \u0434\u043E
      \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0435\u0451 \u043E\u0442\u043A\u0440\u043E\u044E\u0442.
      \u0412 \u044D\u0442\u043E\u043C \u043A\u0440\u0443\u0433\u0435 \u0442\u044B
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0444\u043E\u043B\u0434."
  - Key: item.peek_board.notice
    Value: "\u041F\u041E\u0414\u0421\u041C\u0410\u0422\u0420\u0418\u0412\u0410\u0415\u0422
      \u041E\u0411\u0429\u0423\u042E \u041A\u0410\u0420\u0422\u0423"
  - Key: item.peek_board_main.description
    Value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
