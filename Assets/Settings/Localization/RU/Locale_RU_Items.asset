    Value: "\u041D\u043E\u0436"
  - Key: item.swap_hand.description
    Value: "\u041E\u0431\u043C\u0435\u043D\u044F\u0439 \u043E\u0434\u043D\u0443 \u0438\u0437
      \u0441\u0432\u043E\u0438\u0445 \u043A\u0430\u0440\u0442 \u0441 \u0438\u0433\u0440\u043E\u043A\u043E\u043C,
