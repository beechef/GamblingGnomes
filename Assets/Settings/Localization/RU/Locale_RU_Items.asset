      \u043A\u0430\u0440\u0442\u0430 \u0442\u0435\u0431\u0435 \u0443\u0436\u0435
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
  - Key: item.reason.board_seen
    Value: "\u0412\u0441\u0435 \u043E\u0431\u0449\u0438\u0435 \u043A\u0430\u0440\u0442\u044B
      \u0442\u0435\u0431\u0435 \u0443\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044B."
  - Key: item.reason.board_full
    Value: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430."
  - Key: item.reason.no_card_to_lay
    Value: "\u0422\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u0433\u043E \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C."
  - Key: item.reason.no_card_to_give
    Value: "\u0422\u0435\u0431\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0447\u0435\u0433\u043E
