  - Key: item.reason.nobody_in_hand
    Value: "\u0412 \u0440\u0430\u0437\u0434\u0430\u0447\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442."
  - Key: item.reason.nobody_to_shake
    Value: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u043A\u043E\u043C\u0443
      \u043C\u0435\u043D\u044F\u0442\u044C \u0434\u043E\u0437\u0443."
  - Key: item.reason.nobody_to_roll
    Value: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441 \u043A\u0435\u043C
      \u0431\u0440\u043E\u0441\u0430\u0442\u044C."
  - Key: item.reason.nobody_to_swap
    Value: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441 \u043A\u0435\u043C
      \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438."
  - Key: item.copy_card.name
    Value: "\u041A\u043E\u043F\u0438\u044F"
  - Key: item.copy_card.description
    Value: "\u0421 \u0448\u0430\u043D\u0441\u043E\u043C 35% \u043E\u0434\u043D\u0430
      \u0438\u0437 \u0442\u0432\u043E\u0438\u0445 \u043A\u0430\u0440\u0442 \u0441\u0442\u0430\u043D\u0435\u0442
      \u043A\u043E\u043F\u0438\u0435\u0439 \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0430\u0440\u0442\u044B
      \u0432 \u0442\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0435."
  - Key: item.copy_card.notice
    Value: "\u041F\u0420\u041E\u0411\u0423\u0415\u0422 \u041A\u041E\u041F\u0418\u042E"
  - Key: item.copy_card.copied
    Value: "\u041A\u041E\u041F\u0418\u0420\u0423\u0415\u0422 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.copy_card.failed
    Value: "\u041F\u0420\u041E\u0412\u0410\u041B\u0418\u0412\u0410\u0415\u0422 \u041A\u041E\u041F\u0418\u042E"
  - Key: item.deck_count.name
    Value: "\u041F\u043E\u0434\u0441\u0447\u0451\u0442 \u043C\u0430\u0441\u0442\u0435\u0439"
  - Key: item.deck_count.description
    Value: "\u0423\u0437\u043D\u0430\u0439, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0440\u0442 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u0430\u0441\u0442\u0438
      (\u0438 \u0434\u0436\u043E\u043A\u0435\u0440\u043E\u0432, \u0435\u0441\u043B\u0438
      \u043E\u043D\u0438 \u0435\u0441\u0442\u044C \u0432 \u043A\u043E\u043B\u043E\u0434\u0435)
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432 \u043D\u0435\u0440\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435. \u041F\u043E\u0434\u0441\u0447\u0451\u0442
      \u0432\u0438\u0434\u0438\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u044B,
      \u0438 \u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0441
      \u0442\u043E\u0431\u043E\u0439 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0440\u0430\u0437\u0434\u0430\u0447\u0438."
  - Key: item.deck_count.notice
    Value: "\u0421\u0427\u0418\u0422\u0410\u0415\u0422 \u041A\u041E\u041B\u041E\u0414\u0423"
  - Key: item.extra_draw.name
    Value: "\u0420\u0432\u043E\u0442\u0430"
  - Key: item.extra_draw.description
    Value: "\u0412\u043E\u0437\u044C\u043C\u0438 \u0435\u0449\u0451 \u043E\u0434\u043D\u0443
      \u043A\u0430\u0440\u0442\u0443 \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B.
      \u0414\u043E \u043A\u043E\u043D\u0446\u0430 \u0440\u0430\u0437\u0434\u0430\u0447\u0438
      \u0442\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0444\u043E\u043B\u0434."
  - Key: item.extra_draw.notice
    Value: "\u0414\u041E\u0411\u0418\u0420\u0410\u0415\u0422 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.half_dose.name
    Value: "\u0428\u043F\u0440\u0438\u0446"
  - Key: item.half_dose.description
    Value: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0438\u0433\u0440\u043E\u043A\u0430:
      \u0435\u0433\u043E \u0448\u0430\u043D\u0441 \u0441\u043C\u0435\u0440\u0442\u0438
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0432\u0434\u0432\u043E\u0435, \u0430
      \u0437\u0430\u0442\u0435\u043C \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442
      \u0431\u0440\u043E\u0441\u043E\u043A \u043F\u043E \u043E\u0441\u0442\u0430\u0442\u043A\u0443."
  - Key: item.half_dose.notice
    Value: "\u0412\u0414\u0412\u041E\u0415 \u0421\u041D\u0418\u0416\u0410\u0415\u0422
      \u0414\u041E\u0417\u0423"
  - Key: item.half_dose.prompt
    Value: "\u0423\u041A\u0410\u0416\u0418, \u041A\u041E\u041C\u0423 \u0421\u041D\u0418\u0417\u0418\u0422\u042C
      \u0414\u041E\u0417\u0423 \u0412\u0414\u0412\u041E\u0415"
  - Key: item.joker_card.name
    Value: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430-\u0441\u044E\u0440\u043F\u0440\u0438\u0437"
  - Key: item.joker_card.description
    Value: "\u0421 \u0448\u0430\u043D\u0441\u043E\u043C {0}% \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430 \u0432 \u0442\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u0436\u043E\u043A\u0435\u0440\u043E\u043C.
      \u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u043B\u0438 \u2014
      \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u044B."
  - Key: item.joker_card.joker
    Value: "\u041F\u041E\u041B\u0423\u0427\u0410\u0415\u0422 \u0414\u0416\u041E\u041A\u0415\u0420\u0410"
  - Key: item.joker_card.failed
    Value: "\u041E\u0421\u0422\u0410\u0401\u0422\u0421\u042F \u0411\u0415\u0417 \u0414\u0416\u041E\u041A\u0415\u0420\u0410"
  - Key: item.lock_fold.name
    Value: "\u0417\u0430\u043C\u043E\u043A"
  - Key: item.lock_fold.description
    Value: "\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043A\u0440\u0443\u0433\u0435
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0444\u043E\u043B\u0434, \u0438
      \u0442\u044B \u0442\u043E\u0436\u0435."
  - Key: item.lock_fold.notice
    Value: "\u0417\u0410\u041F\u0420\u0415\u0429\u0410\u0415\u0422 \u0424\u041E\u041B\u0414"
  - Key: item.mushroom_dose.name
    Value: "\u041F\u0440\u0438\u043F\u0440\u0430\u0432\u0430"
  - Key: item.mushroom_dose.description
    Value: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 2 \u0433\u0440\u0438\u0431\u0430
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430
      \u043B\u0438\u0431\u043E \u043D\u0435 \u043F\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442,
      \u043B\u0438\u0431\u043E \u0443\u0434\u0430\u0440\u044F\u0442 \u0432\u0434\u0432\u043E\u0435
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435, 50/50."
  - Key: item.mushroom_dose.notice
    Value: "\u041F\u041E\u0414\u0421\u042B\u041F\u0410\u0415\u0422 \u0427\u0422\u041E-\u0422\u041E"
  - Key: item.mushroom_dose.prompt
    Value: "\u0423\u041A\u0410\u0416\u0418, \u041A\u041E\u041C\u0423 \u041F\u041E\u0414\u0421\u042B\u041F\u0410\u0422\u042C
      \u0412 \u0413\u0420\u0418\u0411\u042B"
  - Key: item.mutual_reveal.name
    Value: "\u0412\u0441\u043A\u0440\u044B\u0442\u0438\u0435 \u0432\u0434\u0432\u043E\u0451\u043C"
  - Key: item.mutual_reveal.description
    Value: "\u0422\u044B \u0438 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u0438\u0433\u0440\u043E\u043A \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0435
      \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u0435
      \u0432\u0441\u0435\u043C\u0443 \u0441\u0442\u043E\u043B\u0443 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430 \u0440\u0430\u0437\u0434\u0430\u0447\u0438.
      \u0421\u0432\u043E\u044E \u043A\u0430\u0440\u0442\u0443 \u043E\u043D \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0430\u043C."
  - Key: item.mutual_reveal.notice
    Value: "\u0412\u0421\u041A\u0420\u042B\u0412\u0410\u0415\u0422\u0421\u042F \u0412\u041C\u0415\u0421\u0422\u0415
      \u0421"
  - Key: item.mutual_reveal.prompt_own
    Value: "\u0423\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u041A\u041E\u0422\u041E\u0420\u0423\u042E
      \u041E\u0422\u041A\u0420\u041E\u0415\u0428\u042C"
  - Key: item.mutual_reveal.prompt_player
    Value: "\u0423\u041A\u0410\u0416\u0418, \u041A\u0422\u041E \u041E\u0422\u041A\u0420\u041E\u0415\u0422\u0421\u042F
      \u0421 \u0422\u041E\u0411\u041E\u0419"
  - Key: item.mutual_reveal.response
    Value: "\u041F\u0420\u041E\u0421\u0418\u0422 \u0422\u0415\u0411\u042F \u041E\u0422\u041A\u0420\u042B\u0422\u042C
      \u041A\u0410\u0420\u0422\u0423: \u0423\u041A\u0410\u0416\u0418 \u041D\u0410
