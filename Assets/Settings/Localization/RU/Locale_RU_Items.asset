      \u0444\u043E\u043B\u0434."
  - Key: item.peek_hand.name
    Value: "\u041F\u043E\u0434\u0433\u043B\u044F\u0434\u043A\u0430"
  - Key: item.peek_hand.description
    Value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043E\u0434\u043D\u0443
      \u043A\u0430\u0440\u0442\u0443 \u0438\u0433\u0440\u043E\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0435\u0449\u0451 \u0432 \u0440\u0430\u0437\u0434\u0430\u0447\u0435. \u0415\u043C\u0443
      \u0441\u043E\u043E\u0431\u0449\u0430\u0442, \u043A\u0430\u043A\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430 \u0437\u0430\u0441\u0432\u0435\u0447\u0435\u043D\u0430."
  - Key: item.peek_hand.notice
    Value: "\u041F\u041E\u0414\u0413\u041B\u042F\u0414\u042B\u0412\u0410\u0415\u0422
