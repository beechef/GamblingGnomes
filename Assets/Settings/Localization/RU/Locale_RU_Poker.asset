  - Key: poker.ruleset.turn_actions
    Value: "\u0412 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u0438\u0433\u0440\u043E\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u043B\u043B,
      \u043F\u043E\u0439\u0442\u0438 \u043E\u043B\u043B-\u0438\u043D \u0438\u043B\u0438
      \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u044B
      (\u0444\u043E\u043B\u0434)."
  - Key: poker.ruleset.turn_actions_items
    Value: "\u0412 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u0438\u0433\u0440\u043E\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0434\u043E {0} \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u0430
      \u0437\u0430\u0442\u0435\u043C \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u043B\u043B
      \u0438\u043B\u0438 \u0444\u043E\u043B\u0434."
  - Key: poker.ruleset.community_cards
    Value: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043A\u0440\u0443\u0433\u0430 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043E\u0431\u0449\u0438\u0435
      \u043A\u0430\u0440\u0442\u044B: {0}."
  - Key: poker.ruleset.all_in
    Value: "\u0415\u0441\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0448\u0451\u043B
      \u043E\u043B\u043B-\u0438\u043D, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C
      \u043E\u043B\u043B-\u0438\u043D\u043E\u043C \u0438\u043B\u0438 \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u043A\u0430\u0440\u0442\u044B. \u0417\u0430\u0442\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432\u0441\u0435 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u043A\u0430\u0440\u0442\u044B."
  - Key: poker.ruleset.showdown
    Value: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B, \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
      \u0438\u0433\u0440\u043E\u043A \u0441 \u0441\u0430\u043C\u043E\u0439 \u0441\u0438\u043B\u044C\u043D\u043E\u0439
      \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0435\u0439."
  - Key: poker.ruleset.winner_feeds
    Value: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0438\u0433\u0440\u043E\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u044A\u0435\u0441\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0439
      \u0433\u0440\u0438\u0431."
  - Key: poker.ruleset.winner_feeds_item
    Value: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0438\u0433\u0440\u043E\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u044A\u0435\u0441\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0439
      \u0433\u0440\u0438\u0431, \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
  - Key: poker.ruleset.losers_eat
    Value: "\u041F\u0440\u043E\u0438\u0433\u0440\u0430\u0432\u0448\u0438\u0435 \u043E\u0431\u044F\u0437\u0430\u043D\u044B
      \u0441\u044A\u0435\u0441\u0442\u044C \u0432\u0441\u0435 \u0433\u0440\u0438\u0431\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438."
  - Key: poker.define.title
    Value: "\u0413\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0438
      \u0438 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0439 \u0433\u0440\u0438\u0431"
  - Key: poker.define.meter_title
    Value: "\u0428\u043A\u0430\u043B\u0430 \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0439"
  - Key: poker.define.meter_description
    Value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u044A\u0435\u0434\u0435\u043D\u043D\u044B\u0439
      \u0433\u0440\u0438\u0431 \u0434\u0430\u0451\u0442 +10% \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0439.
      \u0427\u0435\u043C \u0432\u044B\u0448\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432.
      \u041D\u0430 100% \u2014 \u043F\u0435\u0440\u0435\u0434\u043E\u0437 \u0438
      \u0432\u044B\u043B\u0435\u0442."
  - Key: poker.define.poison_title
    Value: "\u042F\u0434\u043E\u0432\u0438\u0442\u044B\u0439 \u0433\u0440\u0438\u0431"
  - Key: poker.define.poison_description
    Value: "\u041D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0439,
      \u0437\u0430\u0442\u043E \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0431\u0440\u043E\u0441\u043E\u043A
      \u2014 \u0448\u0430\u043D\u0441 \u043F\u0435\u0440\u0435\u0434\u043E\u0437\u0430
