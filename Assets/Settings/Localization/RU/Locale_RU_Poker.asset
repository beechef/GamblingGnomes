  - Key: poker.ruleset.deal_cards_items
    Value: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u043C\u0430\u0442\u0447\u0430
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0433\u0440\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
