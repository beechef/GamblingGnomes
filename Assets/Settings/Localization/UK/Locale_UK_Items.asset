  - Key: item.prompt.board_card
    Value: "\u0412\u041A\u0410\u0416\u0418 \u041D\u0410 \u0417\u0410\u041A\u0420\u0418\u0422\u0423
      \u0421\u041F\u0406\u041B\u042C\u041D\u0423 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.reason.not_dealt
    Value: "\u0417\u0430 \u0446\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C
      \u0439\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0437\u0434\u0430\u044E\u0442\u044C."
  - Key: item.reason.not_held
    Value: "\u0419\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454 \u0432 \u0442\u0435\u0431\u0435
      \u0432 \u0440\u0443\u0446\u0456."
  - Key: item.reason.out_of_match
    Value: "\u0422\u0438 \u0432\u0436\u0435 \u043D\u0435 \u0432 \u043C\u0430\u0442\u0447\u0456."
  - Key: item.reason.street_only
    Value: "\u041B\u0438\u0448\u0435 \u043F\u0456\u0434 \u0447\u0430\u0441 \u043A\u043E\u043B\u0430
      \u0441\u0442\u0430\u0432\u043E\u043A."
  - Key: item.reason.turn_only
    Value: "\u041B\u0438\u0448\u0435 \u0443 \u0441\u0432\u0456\u0439 \u0445\u0456\u0434."
  - Key: item.reason.locked_out
    Value: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      \u043F\u0456\u0434 \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u043E\u044E."
  - Key: item.reason.used_one
    Value: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0443\u0436\u0435 \u0437\u0456\u0433\u0440\u0430\u043D\u043E."
  - Key: item.reason.used_many
    Value: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456 \u0432\u0436\u0435
      \u0437\u0456\u0433\u0440\u0430\u043D\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432:
      {0}."
  - Key: item.reason.waiting_other
    Value: "\u0427\u0435\u043A\u0430\u0454\u043C\u043E \u043D\u0430 \u0456\u043D\u0448\u0438\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
  - Key: item.reason.not_in_hand
    Value: "\u0422\u0438 \u043D\u0435 \u0431\u0435\u0440\u0435\u0448 \u0443\u0447\u0430\u0441\u0442\u0456
      \u0432 \u0446\u0456\u0439 \u0440\u043E\u0437\u0434\u0430\u0447\u0456."
  - Key: item.reason.hand_full
    Value: "\u0420\u0443\u043A\u0430 \u0432\u0436\u0435 \u043F\u043E\u0432\u043D\u0430."
  - Key: item.reason.deck_empty
    Value: "\u041A\u043E\u043B\u043E\u0434\u0430 \u043F\u043E\u0440\u043E\u0436\u043D\u044F."
  - Key: item.reason.no_street_left
    Value: "\u0423 \u0446\u0456\u0439 \u0440\u043E\u0437\u0434\u0430\u0447\u0456
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435\u043C\u0430\u0454 \u043A\u0456\u043B
      \u0441\u0442\u0430\u0432\u043E\u043A."
  - Key: item.reason.no_board
    Value: "\u0417\u0430 \u0446\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C
      \u043D\u0435\u043C\u0430\u0454 \u0441\u043F\u0456\u043B\u044C\u043D\u0438\u0445
      \u043A\u0430\u0440\u0442."
  - Key: item.reason.last_board_seen
    Value: "\u041E\u0441\u0442\u0430\u043D\u043D\u044F \u0441\u043F\u0456\u043B\u044C\u043D\u0430
      \u043A\u0430\u0440\u0442\u0430 \u0442\u043E\u0431\u0456 \u0432\u0436\u0435
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0430."
  - Key: item.reason.board_seen
    Value: "\u0423\u0441\u0456 \u0441\u043F\u0456\u043B\u044C\u043D\u0456 \u043A\u0430\u0440\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0432\u0436\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0456."
  - Key: item.reason.board_full
    Value: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0456 \u043D\u0435\u043C\u0430\u0454
      \u043C\u0456\u0441\u0446\u044F."
  - Key: item.reason.no_card_to_lay
    Value: "\u0422\u043E\u0431\u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u0432\u0438\u043A\u043B\u0430\u0441\u0442\u0438."
  - Key: item.reason.no_card_to_give
    Value: "\u0422\u043E\u0431\u0456 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0447\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0430\u0442\u0438."
  - Key: item.reason.all_face_up
    Value: "\u0423\u0441\u0456 \u043A\u0430\u0440\u0442\u0438 \u0432\u0436\u0435
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0456."
  - Key: item.reason.cant_change
    Value: "\u0416\u043E\u0434\u043D\u0443 \u0437 \u0442\u0432\u043E\u0457\u0445
      \u043A\u0430\u0440\u0442 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0437\u043C\u0456\u043D\u0438\u0442\u0438."
  - Key: item.reason.already_under
    Value: "\u0422\u0438 \u0432\u0436\u0435 \u0432 \u043D\u043E\u043A\u0430\u0443\u0442\u0456."
  - Key: item.reason.nobody_to_halve
    Value: "\u041D\u0456\u043A\u043E\u043C\u0443 \u043D\u0456\u0447\u043E\u0433\u043E
      \u0437\u043C\u0435\u043D\u0448\u0443\u0432\u0430\u0442\u0438 \u0432\u0434\u0432\u0456\u0447\u0456."
  - Key: item.reason.nobody_in_hand
    Value: "\u0423 \u0440\u043E\u0437\u0434\u0430\u0447\u0456 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u043A\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454."
  - Key: item.reason.nobody_to_shake
    Value: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u043A\u043E\u043C\u0443
      \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0434\u043E\u0437\u0443."
  - Key: item.reason.nobody_to_roll
    Value: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0456 \u0437 \u043A\u0438\u043C
      \u043A\u0438\u0434\u0430\u0442\u0438."
  - Key: item.reason.nobody_to_swap
    Value: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0456 \u0437 \u043A\u0438\u043C
      \u043C\u0456\u043D\u044F\u0442\u0438\u0441\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438."
  - Key: item.copy_card.name
    Value: "\u041A\u043E\u043F\u0456\u044F"
  - Key: item.copy_card.description
    Value: "\u0417 \u0448\u0430\u043D\u0441\u043E\u043C 35% \u043E\u0434\u043D\u0430
      \u0437 \u0442\u0432\u043E\u0457\u0445 \u043A\u0430\u0440\u0442 \u0441\u0442\u0430\u043D\u0435
      \u043A\u043E\u043F\u0456\u0454\u044E \u0456\u043D\u0448\u043E\u0457 \u043A\u0430\u0440\u0442\u0438
      \u0443 \u0442\u0432\u043E\u0457\u0439 \u0440\u0443\u0446\u0456."
  - Key: item.copy_card.notice
    Value: "\u041F\u0420\u041E\u0411\u0423\u0404 \u041A\u041E\u041F\u0406\u042E"
  - Key: item.copy_card.copied
    Value: "\u041A\u041E\u041F\u0406\u042E\u0404 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.copy_card.failed
    Value: "\u041F\u0420\u041E\u0412\u0410\u041B\u042E\u0404 \u041A\u041E\u041F\u0406\u042E"
  - Key: item.deck_count.name
    Value: "\u041F\u0456\u0434\u0440\u0430\u0445\u0443\u043D\u043E\u043A \u043C\u0430\u0441\u0442\u0435\u0439"
  - Key: item.deck_count.description
    Value: "\u0414\u0456\u0437\u043D\u0430\u0439\u0441\u044F, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u043A\u0430\u0440\u0442 \u043A\u043E\u0436\u043D\u043E\u0457 \u043C\u0430\u0441\u0442\u0456
      (\u0456 \u0434\u0436\u043E\u043A\u0435\u0440\u0456\u0432, \u044F\u043A\u0449\u043E
      \u0432\u043E\u043D\u0438 \u0454 \u0432 \u043A\u043E\u043B\u043E\u0434\u0456)
      \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F \u0432 \u043D\u0435\u0440\u043E\u0437\u0434\u0430\u043D\u0456\u0439
      \u043A\u043E\u043B\u043E\u0434\u0456. \u041F\u0456\u0434\u0440\u0430\u0445\u0443\u043D\u043E\u043A
      \u0431\u0430\u0447\u0438\u0448 \u043B\u0438\u0448\u0435 \u0442\u0438, \u0456
      \u0432\u0456\u043D \u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F \u0437
      \u0442\u043E\u0431\u043E\u044E \u0434\u043E \u043A\u0456\u043D\u0446\u044F
      \u0440\u043E\u0437\u0434\u0430\u0447\u0456."
  - Key: item.deck_count.notice
    Value: "\u0420\u0410\u0425\u0423\u0404 \u041A\u041E\u041B\u041E\u0414\u0423"
  - Key: item.extra_draw.name
    Value: "\u0411\u043B\u044E\u0432\u043E\u0442\u0430"
  - Key: item.extra_draw.description
    Value: "\u0412\u0456\u0437\u044C\u043C\u0438 \u0449\u0435 \u043E\u0434\u043D\u0443
      \u043A\u0430\u0440\u0442\u0443 \u0437 \u043A\u043E\u043B\u043E\u0434\u0438.
      \u0414\u043E \u043A\u0456\u043D\u0446\u044F \u0440\u043E\u0437\u0434\u0430\u0447\u0456
      \u0442\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0444\u043E\u043B\u0434."
  - Key: item.extra_draw.notice
    Value: "\u0414\u041E\u0411\u0418\u0420\u0410\u0404 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.half_dose.name
    Value: "\u0428\u043F\u0440\u0438\u0446"
  - Key: item.half_dose.description
    Value: "\u041E\u0431\u0435\u0440\u0438 \u0433\u0440\u0430\u0432\u0446\u044F:
      \u0439\u043E\u0433\u043E \u0448\u0430\u043D\u0441 \u0441\u043C\u0435\u0440\u0442\u0456
      \u043F\u0430\u0434\u0430\u0454 \u0432\u0434\u0432\u0456\u0447\u0456, \u0430
      \u043F\u043E\u0442\u0456\u043C \u0432\u0456\u043D \u0440\u043E\u0431\u0438\u0442\u044C
      \u043A\u0438\u0434\u043E\u043A \u043D\u0430 \u0442\u0435, \u0449\u043E \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F."
  - Key: item.half_dose.notice
    Value: "\u0412\u0414\u0412\u0406\u0427\u0406 \u0417\u041C\u0415\u041D\u0428\u0423\u0404
      \u0414\u041E\u0417\u0423"
  - Key: item.half_dose.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418, \u041A\u041E\u041C\u0423 \u0417\u041C\u0415\u041D\u0428\u0418\u0422\u0418
      \u0414\u041E\u0417\u0423 \u0412\u0414\u0412\u0406\u0427\u0406"
  - Key: item.joker_card.name
    Value: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430-\u0441\u044E\u0440\u043F\u0440\u0438\u0437"
  - Key: item.joker_card.description
    Value: "\u0417 \u0448\u0430\u043D\u0441\u043E\u043C {0}% \u043E\u0431\u0440\u0430\u043D\u0430
      \u043A\u0430\u0440\u0442\u0430 \u0443 \u0442\u0432\u043E\u0457\u0439 \u0440\u0443\u0446\u0456
      \u0441\u0442\u0430\u043D\u0435 \u0434\u0436\u043E\u043A\u0435\u0440\u043E\u043C.
      \u0427\u0438 \u0432\u0438\u0439\u0448\u043B\u043E \u2014 \u0434\u0456\u0437\u043D\u0430\u0454\u0448\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0442\u0438."
  - Key: item.joker_card.joker
    Value: "\u041E\u0422\u0420\u0418\u041C\u0423\u0404 \u0414\u0416\u041E\u041A\u0415\u0420\u0410"
  - Key: item.joker_card.failed
    Value: "\u041B\u0418\u0428\u0410\u0404\u0422\u042C\u0421\u042F \u0411\u0415\u0417
      \u0414\u0416\u041E\u041A\u0415\u0420\u0410"
  - Key: item.lock_fold.name
    Value: "\u0417\u0430\u043C\u043E\u043A"
  - Key: item.lock_fold.description
    Value: "\u0423 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443 \u043A\u043E\u043B\u0456
      \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0444\u043E\u043B\u0434, \u0456 \u0442\u0438 \u0442\u0435\u0436."
  - Key: item.lock_fold.notice
    Value: "\u0417\u0410\u0411\u041E\u0420\u041E\u041D\u042F\u0404 \u0424\u041E\u041B\u0414"
  - Key: item.mushroom_dose.name
    Value: "\u041F\u0440\u0438\u043F\u0440\u0430\u0432\u0430"
  - Key: item.mushroom_dose.description
    Value: "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0456 2 \u0433\u0440\u0438\u0431\u0438
      \u043E\u0431\u0440\u0430\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u0432\u0446\u044F
      \u0430\u0431\u043E \u043D\u0435 \u043F\u043E\u0434\u0456\u044E\u0442\u044C,
      \u0430\u0431\u043E \u0432\u0434\u0430\u0440\u044F\u0442\u044C \u0443\u0434\u0432\u0456\u0447\u0456
      \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435, 50/50."
  - Key: item.mushroom_dose.notice
    Value: "\u041F\u0406\u0414\u0421\u0418\u041F\u0410\u0404 \u0429\u041E\u0421\u042C"
  - Key: item.mushroom_dose.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418, \u041A\u041E\u041C\u0423 \u041F\u0406\u0414\u0421\u0418\u041F\u0410\u0422\u0418
      \u0412 \u0413\u0420\u0418\u0411\u0418"
  - Key: item.mutual_reveal.name
    Value: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F \u0432\u0434\u0432\u043E\u0445"
  - Key: item.mutual_reveal.description
    Value: "\u0422\u0438 \u0439 \u043E\u0431\u0440\u0430\u043D\u0438\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u0435 \u043F\u043E
      \u043E\u0434\u043D\u0456\u0439 \u043A\u0430\u0440\u0442\u0456 \u0432\u0441\u044C\u043E\u043C\u0443
      \u0441\u0442\u043E\u043B\u0443 \u0434\u043E \u043A\u0456\u043D\u0446\u044F
      \u0440\u043E\u0437\u0434\u0430\u0447\u0456. \u0421\u0432\u043E\u044E \u043A\u0430\u0440\u0442\u0443
      \u0432\u0456\u043D \u043E\u0431\u0438\u0440\u0430\u0454 \u0441\u0430\u043C."
  - Key: item.mutual_reveal.notice
    Value: "\u0412\u0406\u0414\u041A\u0420\u0418\u0412\u0410\u0404\u0422\u042C\u0421\u042F
      \u0420\u0410\u0417\u041E\u041C \u0417"
  - Key: item.mutual_reveal.prompt_own
    Value: "\u0412\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u042F\u041A\u0423
      \u0412\u0406\u0414\u041A\u0420\u0418\u0404\u0428"
  - Key: item.mutual_reveal.prompt_player
    Value: "\u0412\u041A\u0410\u0416\u0418, \u0425\u0422\u041E \u0412\u0406\u0414\u041A\u0420\u0418\u0404\u0422\u042C\u0421\u042F
      \u0417 \u0422\u041E\u0411\u041E\u042E"
  - Key: item.mutual_reveal.response
    Value: "\u041F\u0420\u041E\u0421\u0418\u0422\u042C \u0422\u0415\u0411\u0415 \u0412\u0406\u0414\u041A\u0420\u0418\u0422\u0418
      \u041A\u0410\u0420\u0422\u0423: \u0412\u041A\u0410\u0416\u0418 \u041D\u0410
      \u041E\u0414\u041D\u0423"
  - Key: item.pair_lock_fold.name
    Value: "\u041A\u0430\u0439\u0434\u0430\u043D\u043A\u0438"
  - Key: item.pair_lock_fold.description
    Value: "\u0422\u0438 \u0439 \u043E\u0431\u0440\u0430\u043D\u0438\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0444\u043E\u043B\u0434 \u0443 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443
      \u043A\u043E\u043B\u0456."
  - Key: item.pair_lock_fold.notice
    Value: "\u041F\u0420\u0418\u041A\u041E\u0412\u0423\u0404\u0422\u042C\u0421\u042F
      \u0414\u041E"
  - Key: item.pair_lock_items.name
    Value: "\u0411\u0435\u0437 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432"
  - Key: item.pair_lock_items.description
    Value: "\u0422\u0438 \u0439 \u043E\u0431\u0440\u0430\u043D\u0438\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438 \u0432 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443
      \u043A\u043E\u043B\u0456."
  - Key: item.pair_lock_items.notice
    Value: "\u0417\u0410\u0411\u041E\u0420\u041E\u041D\u042F\u0404 \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u0418
      \u0421\u041E\u0411\u0406 \u0419"
  - Key: item.pair_lock.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418, \u041A\u041E\u0413\u041E \u0417\u0410\u041C\u041A\u041D\u0423\u0422\u0418
      \u0417 \u0421\u041E\u0411\u041E\u042E"
  - Key: item.peek_board.name
    Value: "\u041B\u043E\u043F\u0430\u0442\u043A\u0430"
  - Key: item.peek_board.description
    Value: "\u041F\u043E\u0434\u0438\u0432\u0438\u0441\u044F \u043E\u0434\u043D\u0443
      \u0441\u043F\u0456\u043B\u044C\u043D\u0443 \u043A\u0430\u0440\u0442\u0443,
      \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0457\u0457 \u0432\u0456\u0434\u043A\u0440\u0438\u044E\u0442\u044C.
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456 \u0442\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0444\u043E\u043B\u0434."
  - Key: item.peek_board.notice
    Value: "\u041F\u0406\u0414\u0413\u041B\u042F\u0414\u0410\u0404 \u0421\u041F\u0406\u041B\u042C\u041D\u0423
      \u041A\u0410\u0420\u0422\u0423"
  - Key: item.peek_board_main.description
    Value: "\u041F\u043E\u0434\u0438\u0432\u0438\u0441\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u044E
      \u0441\u043F\u0456\u043B\u044C\u043D\u0443 \u043A\u0430\u0440\u0442\u0443,
      \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0457\u0457 \u0432\u0456\u0434\u043A\u0440\u0438\u044E\u0442\u044C.
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456 \u0442\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0444\u043E\u043B\u0434."
  - Key: item.peek_hand.name
    Value: "\u041F\u0456\u0434\u0433\u043B\u044F\u0434"
  - Key: item.peek_hand.description
    Value: "\u041F\u043E\u0434\u0438\u0432\u0438\u0441\u044F \u043E\u0434\u043D\u0443
      \u043A\u0430\u0440\u0442\u0443 \u0433\u0440\u0430\u0432\u0446\u044F, \u044F\u043A\u0438\u0439
      \u0449\u0435 \u0432 \u0440\u043E\u0437\u0434\u0430\u0447\u0456. \u0419\u043E\u043C\u0443
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0442\u044C, \u044F\u043A\u0443
      \u043A\u0430\u0440\u0442\u0443 \u0437\u0430\u0441\u0432\u0456\u0447\u0435\u043D\u043E."
  - Key: item.peek_hand.notice
    Value: "\u041F\u0406\u0414\u0413\u041B\u042F\u0414\u0410\u0404 \u041A\u0410\u0420\u0422\u0423
      \u0412"
  - Key: item.place_on_board.name
    Value: "\u0426\u0438\u0433\u0430\u0440\u043A\u0430"
  - Key: item.place_on_board.description
    Value: "\u0412\u0438\u043A\u043B\u0430\u0434\u0438 \u043E\u0434\u043D\u0443 \u0437\u0456
      \u0441\u0432\u043E\u0457\u0445 \u043A\u0430\u0440\u0442 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E
      \u043D\u0430 \u0441\u0442\u0456\u043B \u0434\u043B\u044F \u0432\u0441\u0456\u0445
      \u0456 \u0432\u0456\u0437\u044C\u043C\u0438 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u043D\u0435\u0457 \u043D\u043E\u0432\u0443 \u0437 \u043A\u043E\u043B\u043E\u0434\u0438."
  - Key: item.place_on_board.notice
    Value: "\u0412\u0418\u041A\u041B\u0410\u0414\u0410\u0404 \u041A\u0410\u0420\u0422\u0423"
  - Key: item.place_on_board.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u042F\u041A\u0423
      \u0412\u0418\u041A\u041B\u0410\u0414\u0415\u0428 \u041D\u0410 \u0421\u0422\u0406\u041B"
  - Key: item.raise_stakes.name
    Value: "\u0420\u0435\u0439\u0437"
  - Key: item.raise_stakes.description
    Value: "\u041A\u043E\u0436\u043D\u0430 \u0441\u0442\u0430\u0432\u043A\u0430 \u0432
      \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443 \u043A\u043E\u043B\u0456
      \u043A\u043E\u0448\u0442\u0443\u0454 \u043D\u0430 \u043E\u0434\u0438\u043D
      \u0433\u0440\u0438\u0431 \u0431\u0456\u043B\u044C\u0448\u0435, \u0442\u0432\u043E\u044F
      \u0442\u0435\u0436."
  - Key: item.raise_stakes.notice
    Value: "\u041F\u0406\u0414\u0412\u0418\u0429\u0423\u0404 \u0421\u0422\u0410\u0412\u041A\u0418"
  - Key: item.random_suit.name
    Value: "\u041A\u0443\u0431\u0438\u043A"
  - Key: item.random_suit.description
    Value: "\u041E\u0434\u043D\u0430 \u0437 \u0442\u0432\u043E\u0457\u0445 \u043A\u0430\u0440\u0442
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0440\u0430\u043D\u0433 \u0456
