  - Key: item.shared_roll.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418, \u0425\u0422\u041E \u041A\u0418\u041D\u0415
      \u0420\u0410\u0417\u041E\u041C \u0417 \u0422\u041E\u0411\u041E\u042E"
  - Key: item.swap_board.name
    Value: "\u0426\u0438\u0433\u0430\u0440\u043A\u0430"
  - Key: item.swap_board.description
    Value: "\u0417\u0430\u043A\u0440\u0438\u0442\u0430 \u0441\u043F\u0456\u043B\u044C\u043D\u0430
      \u043A\u0430\u0440\u0442\u0430 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0432\u0441\u0456\u0445, \u0430 \u043F\u043E\u0442\u0456\u043C
      \u043E\u0431\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      \u043E\u0434\u043D\u0443 \u0437 \u0442\u0432\u043E\u0457\u0445 \u043A\u0430\u0440\u0442,
      \u044F\u043A\u0430 \u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E\u044E
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0456."
  - Key: item.swap_board.notice
    Value: "\u041E\u0411\u041C\u0406\u041D\u042E\u0404\u0422\u042C\u0421\u042F \u0417\u0406
      \u0421\u0422\u041E\u041B\u041E\u041C"
  - Key: item.swap_board.prompt
    Value: "\u0412\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u042F\u041A\u0423
      \u041F\u041E\u041A\u041B\u0410\u0414\u0415\u0428 \u041D\u0410 \u0421\u0422\u0406\u041B"
  - Key: item.swap_hand.name
    Value: "\u041D\u0456\u0436"
  - Key: item.swap_hand.description
    Value: "\u041E\u0431\u043C\u0456\u043D\u044F\u0439 \u043E\u0434\u043D\u0443 \u0437\u0456
      \u0441\u0432\u043E\u0457\u0445 \u043A\u0430\u0440\u0442 \u0456\u0437 \u0433\u0440\u0430\u0432\u0446\u0435\u043C,
      \u044F\u043A\u0438\u0439 \u0449\u0435 \u0432 \u0440\u043E\u0437\u0434\u0430\u0447\u0456.
      \u042F\u043A\u0443 \u0432\u0456\u0434\u0434\u0430\u0442\u0438, \u0432\u0456\u043D
      \u043E\u0431\u0438\u0440\u0430\u0454 \u0441\u0430\u043C."
  - Key: item.swap_hand.notice
    Value: "\u041E\u0411\u041C\u0406\u041D\u042E\u0404\u0422\u042C\u0421\u042F \u041A\u0410\u0420\u0422\u041E\u042E
      \u0417"
  - Key: item.swap_hand.prompt_own
    Value: "\u0412\u041A\u0410\u0416\u0418 \u041A\u0410\u0420\u0422\u0423, \u042F\u041A\u0423
      \u0412\u0406\u0414\u0414\u0410\u0421\u0418"
  - Key: item.swap_hand.prompt_player
    Value: "\u0412\u041A\u0410\u0416\u0418, \u0417 \u041A\u0418\u041C \u041C\u0406\u041D\u042F\u0404\u0428\u0421\u042F"
  - Key: item.swap_hand.response
    Value: "\u043C\u0456\u043D\u044F\u0454\u0442\u044C\u0441\u044F \u0437 \u0442\u043E\u0431\u043E\u044E
      \u043A\u0430\u0440\u0442\u043E\u044E \u2014 \u043E\u0431\u0435\u0440\u0438,
      \u044F\u043A\u0443 \u0432\u0456\u0434\u0434\u0430\u0442\u0438"
  - Key: item.table_reveal.name
    Value: "\u0413\u0443\u0447\u043D\u043E\u043C\u043E\u0432\u0435\u0446\u044C"
  - Key: item.table_reveal.description
    Value: "\u041A\u043E\u0436\u0435\u043D \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u0443 \u0440\u043E\u0437\u0434\u0430\u0447\u0456 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u0432\u0441\u044C\u043E\u043C\u0443 \u0441\u0442\u043E\u043B\u0443 \u043E\u0434\u043D\u0443
      \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0443 \u043A\u0430\u0440\u0442\u0443
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043B\u0456."
  - Key: item.table_reveal.notice
    Value: "\u0420\u041E\u0417\u041A\u0420\u0418\u0412\u0410\u0404 \u0412\u0415\u0421\u042C
      \u0421\u0422\u0406\u041B"
  - Key: item.reason.no_time
    Value: "\u041D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C \u0447\u0430\u0441\u0443
      \u043D\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C."
