  m_Script: {fileID: 11500000, guid: 48cfa9c17f2bc884ba9c1aad02a042a1, type: 3}
  m_Name: Locale_UK_Hands
  m_EditorClassIdentifier: Localization::Localization.LocaleSection
  _entries:
  - Key: hand.five_of_a_kind.name
    Value: "\u041F'\u044F\u0442\u044C \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u0438\u0445"
  - Key: hand.five_of_a_kind.description
    Value: "\u041F'\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443. \u041C\u043E\u0436\u043B\u0438\u0432\u043E
      \u043B\u0438\u0448\u0435 \u0437 \u0434\u0436\u043E\u043A\u0435\u0440\u043E\u043C."
  - Key: hand.royal_flush.name
    Value: "\u0420\u043E\u044F\u043B-\u0444\u043B\u0435\u0448"
  - Key: hand.royal_flush.description
    Value: "\u0422\u0443\u0437, \u043A\u043E\u0440\u043E\u043B\u044C, \u0434\u0430\u043C\u0430,
      \u0432\u0430\u043B\u0435\u0442 \u0456 \u0434\u0435\u0441\u044F\u0442\u043A\u0430
      \u043E\u0434\u043D\u0456\u0454\u0457 \u043C\u0430\u0441\u0442\u0456."
  - Key: hand.straight_flush.name
    Value: "\u0421\u0442\u0440\u0456\u0442-\u0444\u043B\u0435\u0448"
  - Key: hand.straight_flush.description
    Value: "\u041F'\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043F\u043E\u0441\u043F\u0456\u043B\u044C
      \u0437\u0430 \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u043E\u043C, \u0443\u0441\u0456
      \u043E\u0434\u043D\u0456\u0454\u0457 \u043C\u0430\u0441\u0442\u0456."
  - Key: hand.four_of_a_kind.name
    Value: "\u041A\u0430\u0440\u0435"
  - Key: hand.four_of_a_kind.description
    Value: "\u0427\u043E\u0442\u0438\u0440\u0438 \u043A\u0430\u0440\u0442\u0438 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443."
  - Key: hand.full_house.name
    Value: "\u0424\u0443\u043B-\u0445\u0430\u0443\u0441"
  - Key: hand.full_house.description
    Value: "\u0422\u0440\u0438 \u043A\u0430\u0440\u0442\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443 \u0456 \u0434\u0432\u0456
      \u043A\u0430\u0440\u0442\u0438 \u0456\u043D\u0448\u043E\u0433\u043E \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443."
  - Key: hand.flush.name
    Value: "\u0424\u043B\u0435\u0448"
  - Key: hand.flush.description
    Value: "\u041F'\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u0456\u0454\u0457
      \u043C\u0430\u0441\u0442\u0456."
  - Key: hand.straight.name
    Value: "\u0421\u0442\u0440\u0456\u0442"
  - Key: hand.straight.description
    Value: "\u041F'\u044F\u0442\u044C \u043A\u0430\u0440\u0442 \u043F\u043E\u0441\u043F\u0456\u043B\u044C
      \u0437\u0430 \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u043E\u043C."
  - Key: hand.three_of_a_kind.name
    Value: "\u0422\u0440\u0456\u0439\u043A\u0430"
  - Key: hand.three_of_a_kind.description
    Value: "\u0422\u0440\u0438 \u043A\u0430\u0440\u0442\u0438 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443."
  - Key: hand.two_pair.name
    Value: "\u0414\u0432\u0456 \u043F\u0430\u0440\u0438"
  - Key: hand.two_pair.description
    Value: "\u0414\u0432\u0456 \u043F\u0430\u0440\u0438 \u0440\u0456\u0437\u043D\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443."
  - Key: hand.pair.name
    Value: "\u041F\u0430\u0440\u0430"
  - Key: hand.pair.description
    Value: "\u0414\u0432\u0456 \u043A\u0430\u0440\u0442\u0438 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u043D\u043E\u043C\u0456\u043D\u0430\u043B\u0443."
  - Key: hand.high_card.name
    Value: "\u0421\u0442\u0430\u0440\u0448\u0430 \u043A\u0430\u0440\u0442\u0430"
  - Key: hand.high_card.description
    Value: "\u041F'\u044F\u0442\u044C \u043A\u0430\u0440\u0442, \u0449\u043E \u043D\u0435
      \u0443\u0442\u0432\u043E\u0440\u044E\u044E\u0442\u044C \u0456\u043D\u0448\u043E\u0457
      \u043F\u043E\u043A\u0435\u0440\u043D\u043E\u0457 \u043A\u043E\u043C\u0431\u0456\u043D\u0430\u0446\u0456\u0457."
