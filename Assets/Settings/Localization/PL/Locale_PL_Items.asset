  - Key: item.mushroom_dose.doubled
    Value: "PODWAJA GRZYBY \xD7{0}"
  - Key: item.mushroom_dose.prompt
    Value: "WSKA\u017B, KOMU DOPRAWIASZ GRZYBY"
  - Key: item.mutual_reveal.name
    Value: "Wsp\xF3lny pokaz"
  - Key: item.mutual_reveal.description
    Value: "Ty i wybrany gracz odkrywacie po jednej karcie dla ca\u0142ego sto\u0142u
      do ko\u0144ca rozdania. On wybiera, kt\xF3r\u0105 ze swoich."
  - Key: item.mutual_reveal.notice
    Value: ODKRYWA RAZEM Z
  - Key: item.mutual_reveal.prompt_own
    Value: "WSKA\u017B KART\u0118, KT\xD3R\u0104 POKA\u017BESZ"
  - Key: item.mutual_reveal.prompt_player
    Value: "WSKA\u017B, KTO POKA\u017BE KART\u0118 Z TOB\u0104"
  - Key: item.mutual_reveal.response
    Value: "KA\u017BE CI POKAZA\u0106 KART\u0118: WSKA\u017B JEDN\u0104"
  - Key: item.pair_lock_fold.name
    Value: Kajdanki
  - Key: item.pair_lock_fold.description
    Value: "Ty i wybrany gracz nie mo\u017Cecie spasowa\u0107 w nast\u0119pnej rundzie."
  - Key: item.pair_lock_fold.notice
    Value: "SKUWA SI\u0118 Z"
  - Key: item.pair_lock_items.name
    Value: "Bez przedmiot\xF3w"
  - Key: item.pair_lock_items.description
    Value: "Ty i wybrany gracz nie mo\u017Cecie u\u017Cywa\u0107 przedmiot\xF3w w
      nast\u0119pnej rundzie."
  - Key: item.pair_lock_items.notice
    Value: BLOKUJE PRZEDMIOTY
  - Key: item.pair_lock.prompt
    Value: "WSKA\u017B, KTO ZOSTANIE ZABLOKOWANY Z TOB\u0104"
  - Key: item.peek_board.name
    Value: "\u0141opatka"
  - Key: item.peek_board.description
    Value: "Zobacz jedn\u0105 kart\u0119 wsp\xF3ln\u0105, zanim zostanie odkryta.
      W tej rundzie nie mo\u017Cesz spasowa\u0107."
  - Key: item.peek_board.notice
    Value: "ZERKA NA ST\xD3\u0141"
  - Key: item.peek_board_main.description
    Value: "Zobacz ostatni\u0105 kart\u0119 wsp\xF3ln\u0105, zanim zostanie odkryta.
      W tej rundzie nie mo\u017Cesz spasowa\u0107."
  - Key: item.peek_hand.name
    Value: "Podgl\u0105d"
  - Key: item.peek_hand.description
    Value: "Zobacz jedn\u0105 kart\u0119 gracza, kt\xF3ry jest jeszcze w rozdaniu.
      Dowie si\u0119, kt\xF3r\u0105 kart\u0119 podejrzano."
  - Key: item.peek_hand.notice
    Value: ZERKA W KARTY
  - Key: item.peek_hand.private
    Value: "WIDZI TWOJ\u0104 KART\u0118 {0}"
  - Key: item.place_on_board.name
    Value: Papieros
  - Key: item.place_on_board.description
    Value: "Wy\u0142\xF3\u017C jedn\u0105 ze swoich kart odkryt\u0105 na st\xF3\u0142
      dla wszystkich i dobierz na jej miejsce now\u0105 z talii."
  - Key: item.place_on_board.notice
    Value: "WYK\u0141ADA KART\u0118"
  - Key: item.place_on_board.prompt
    Value: "WSKA\u017B KART\u0118 DO WY\u0141O\u017BENIA NA ST\xD3\u0141"
  - Key: item.raise_stakes.name
    Value: Podbicie
  - Key: item.raise_stakes.description
    Value: "Ka\u017Cdy zak\u0142ad w nast\u0119pnej rundzie kosztuje o jeden grzyb
      wi\u0119cej, tw\xF3j te\u017C."
  - Key: item.raise_stakes.notice
    Value: "PODNOSI STAWK\u0118"
  - Key: item.random_suit.name
    Value: "Ko\u015Bci"
  - Key: item.random_suit.description
    Value: "Jedna z twoich kart zachowuje warto\u015B\u0107 i dostaje inny, losowy
      kolor."
  - Key: item.random_suit.notice
    Value: ZMIENIA KOLOR
  - Key: item.random_suit.prompt
    Value: "WSKA\u017B KART\u0118 DO ZMIANY"
  - Key: item.rate_shift.name
    Value: Majtki
  - Key: item.rate_shift.description
    Value: "Wybierz gracza: jego szansa na \u015Bmier\u0107 losowo ro\u015Bnie lub
      spada o 20."
  - Key: item.rate_shift.raised
    Value: +{0} DO DAWKI
  - Key: item.rate_shift.lowered
    Value: -{0} Z DAWKI
  - Key: item.rate_shift.prompt
    Value: "WSKA\u017B, KOMU ZMIENIASZ DAWK\u0118"
  - Key: item.shared_roll.name
    Value: Piwo
  - Key: item.shared_roll.description
    Value: "Ty i wybrany gracz rzucacie jednocze\u015Bnie, ka\u017Cdy o swoj\u0105
      szans\u0119 na \u015Bmier\u0107."
  - Key: item.shared_roll.notice
    Value: RZUCA RAZEM Z
  - Key: item.shared_roll.prompt
    Value: "WSKA\u017B, KTO RZUCA Z TOB\u0104"
  - Key: item.swap_board.name
    Value: Papieros
  - Key: item.swap_board.description
    Value: "Zakryta karta wsp\xF3lna zostaje odkryta dla wszystkich, a potem wymieniona
      na jedn\u0105 z twoich kart, kt\xF3ra zostaje odkryta na stole."
  - Key: item.swap_board.notice
    Value: "WYMIENIA ZE STO\u0141EM"
  - Key: item.swap_board.prompt
    Value: "WSKA\u017B KART\u0118, KT\xD3R\u0104 K\u0141ADZIESZ NA ST\xD3\u0141"
  - Key: item.swap_hand.name
    Value: "N\xF3\u017C"
  - Key: item.swap_hand.description
    Value: "Wymie\u0144 jedn\u0105 ze swoich kart z graczem, kt\xF3ry jest jeszcze
      w rozdaniu. On wybiera, kt\xF3r\u0105 ze swoich odda."
  - Key: item.swap_hand.notice
    Value: "WYMIENIA SI\u0118 Z"
  - Key: item.swap_hand.prompt_own
    Value: "WSKA\u017B KART\u0118, KT\xD3R\u0104 ODDAJESZ"
  - Key: item.swap_hand.prompt_player
    Value: "WSKA\u017B, Z KIM SI\u0118 WYMIENIASZ"
  - Key: item.swap_hand.response
    Value: "wymienia si\u0119 z tob\u0105 kart\u0105 - wybierz jedn\u0105 do wymiany"
  - Key: item.table_reveal.name
    Value: Megafon
  - Key: item.table_reveal.description
    Value: "W tej rundzie ka\u017Cdy gracz w rozdaniu pokazuje ca\u0142emu sto\u0142owi
      jedn\u0105 losow\u0105 kart\u0119."
  - Key: item.table_reveal.notice
    Value: "ODS\u0141ANIA WSZYSTKICH"
