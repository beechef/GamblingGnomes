  - Key: item.lock_fold.notice
    Value: BLOKUJE PASOWANIE
  - Key: item.mushroom_dose.name
    Value: Domieszka
  - Key: item.mushroom_dose.description
    Value: "Nast\u0119pne 2 grzyby wybranego gracza albo nic nie zrobi\u0105, albo
