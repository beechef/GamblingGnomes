  - Key: item.half_dose.notice
    Value: "dozu yar\u0131lad\u0131 \u2192"
  - Key: item.half_dose.prompt
    Value: "DOZU YARIYA \u0130NECEK K\u0130\u015E\u0130Y\u0130 \u0130\u015EARET ET"
