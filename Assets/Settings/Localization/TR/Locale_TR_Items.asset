  - Key: item.random_suit.notice
    Value: "kart\u0131n rengini de\u011Fi\u015Ftirdi"
  - Key: item.random_suit.prompt
    Value: "DE\u011E\u0130\u015EECEK KARTI \u0130\u015EARET ET"
  - Key: item.rate_shift.name
    Value: "K\xFClot"
  - Key: item.rate_shift.description
    Value: "Bir oyuncu se\xE7: \xF6l\xFCm oran\u0131 rastgele 20 artar ya da azal\u0131r."
  - Key: item.rate_shift.raised
