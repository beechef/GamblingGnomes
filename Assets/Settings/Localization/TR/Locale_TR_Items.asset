  - Key: item.mutual_reveal.notice
    Value: "birlikte kart a\xE7\u0131yor \u2192"
  - Key: item.mutual_reveal.prompt_own
    Value: "A\xC7ACA\u011EIN KARTI \u0130\u015EARET ET"
  - Key: item.mutual_reveal.prompt_player
    Value: "SEN\u0130NLE KART A\xC7ACAK K\u0130\u015E\u0130Y\u0130 \u0130\u015EARET
