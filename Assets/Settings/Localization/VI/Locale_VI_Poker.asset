  - Key: poker.ruleset.deal_cards
    Value: "\u0110\u1EA7u m\u1ED7i v\xE1n, m\u1ED7i ng\u01B0\u1EDDi ch\u01A1i \u0111\u01B0\u1EE3c
      chia {0} l\xE1 b\xE0i ri\xEAng (Hole Card)."
  - Key: poker.ruleset.deal_cards_items
    Value: "\u0110\u1EA7u m\u1ED7i v\xE1n, m\u1ED7i ng\u01B0\u1EDDi ch\u01A1i \u0111\u01B0\u1EE3c
      chia {0} l\xE1 b\xE0i ri\xEAng (Hole Card) v\xE0 {1} v\u1EADt ph\u1EA9m."
  - Key: poker.ruleset.turn_actions
    Value: "\u0110\u1EBFn l\u01B0\u1EE3t m\xECnh, ng\u01B0\u1EDDi ch\u01A1i c\xF3
      th\u1EC3 Theo, T\u1EA5t tay ho\u1EB7c B\u1ECF b\xE0i."
  - Key: poker.ruleset.turn_actions_items
    Value: "\u0110\u1EBFn l\u01B0\u1EE3t m\xECnh, ng\u01B0\u1EDDi ch\u01A1i c\xF3
      th\u1EC3 d\xF9ng t\u1ED1i \u0111a {0} v\u1EADt ph\u1EA9m, r\u1ED3i Theo ho\u1EB7c
      B\u1ECF b\xE0i."
  - Key: poker.ruleset.community_cards
    Value: "Cu\u1ED1i m\u1ED7i v\xF2ng, {0} l\xE1 b\xE0i board \u0111\u01B0\u1EE3c
      l\u1EADt theo th\u1EE9 t\u1EF1."
  - Key: poker.ruleset.all_in
    Value: "Khi c\xF3 ng\u01B0\u1EDDi T\u1EA5t tay, nh\u1EEFng ng\u01B0\u1EDDi ch\u01A1i
      kh\xE1c ch\u1EC9 c\xF3 th\u1EC3 Theo ho\u1EB7c B\u1ECF b\xE0i. Sau \u0111\xF3,
      t\u1EA5t c\u1EA3 l\xE1 b\xE0i board c\xF2n l\u1EA1i \u0111\u01B0\u1EE3c l\u1EADt."
  - Key: poker.ruleset.showdown
    Value: "Khi t\u1EA5t c\u1EA3 l\xE1 b\xE0i board \u0111\xE3 \u0111\u01B0\u1EE3c
      l\u1EADt, ng\u01B0\u1EDDi ch\u01A1i c\xF3 tay b\xE0i m\u1EA1nh nh\u1EA5t s\u1EBD
      th\u1EAFng."
  - Key: poker.ruleset.winner_feeds
    Value: "Ng\u01B0\u1EDDi th\u1EAFng ch\u1ECDn m\u1ED9t ng\u01B0\u1EDDi ch\u01A1i
      \u0111\u1EC3 \u0103n n\u1EA5m \u0111\u1ED9c."
  - Key: poker.ruleset.winner_feeds_item
    Value: "Ng\u01B0\u1EDDi th\u1EAFng ch\u1ECDn m\u1ED9t ng\u01B0\u1EDDi ch\u01A1i
      \u0111\u1EC3 \u0103n n\u1EA5m \u0111\u1ED9c. N\u1EBFu ng\u01B0\u1EDDi \u0111\xF3
      s\u1ED1ng s\xF3t, h\u1ECD nh\u1EADn th\xEAm m\u1ED9t v\u1EADt ph\u1EA9m."
  - Key: poker.ruleset.losers_eat
    Value: "Ng\u01B0\u1EDDi thua ph\u1EA3i \u0103n h\u1EBFt s\u1ED1 n\u1EA5m m\xE0
      m\xECnh \u0111\xE3 c\u01B0\u1EE3c."
  - Key: poker.define.title
    Value: "\u1EA2o gi\xE1c & N\u1EA5m \u0111\u1ED9c"
  - Key: poker.define.meter_title
    Value: "Thanh \u1EA3o gi\xE1c"
  - Key: poker.define.meter_description
    Value: "M\u1ED7i c\xE2y n\u1EA5m b\u1EA1n \u0103n s\u1EBD t\u0103ng 10% t\u1EF7
      l\u1EC7 \u1EA3o gi\xE1c. T\u1EF7 l\u1EC7 c\xE0ng cao, hi\u1EC7u \u1EE9ng c\xE0ng
      m\u1EA1nh. \u0110\u1EA1t 100% b\u1EA1n s\u1EBD qu\xE1 li\u1EC1u v\xE0 b\u1ECB
      lo\u1EA1i kh\u1ECFi tr\u1EADn."
  - Key: poker.define.poison_title
    Value: "N\u1EA5m \u0111\u1ED9c"
  - Key: poker.define.poison_description
    Value: "Kh\xF4ng t\u0103ng \u1EA3o gi\xE1c. Thay v\xE0o \u0111\xF3, n\xF3 k\xEDch
      ho\u1EA1t Death Roll: m\u1ED9t c\u01A1 h\u1ED9i ng\u1EABu nhi\xEAn b\u1ECB
      qu\xE1 li\u1EC1u, d\u1EF1a tr\xEAn t\u1EF7 l\u1EC7 \u1EA3o gi\xE1c hi\u1EC7n
      t\u1EA1i c\u1EE7a b\u1EA1n."
