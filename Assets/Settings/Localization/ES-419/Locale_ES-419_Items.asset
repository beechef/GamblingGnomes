  - Key: item.swap_board.notice
    Value: CAMBIA CON LA MESA
  - Key: item.swap_board.prompt
    Value: "SE\xD1ALA LA CARTA QUE PONES EN LA MESA"
  - Key: item.swap_hand.name
    Value: Cuchillo
  - Key: item.swap_hand.description
    Value: "Cambia una de tus cartas con un jugador que siga en la mano. El otro
