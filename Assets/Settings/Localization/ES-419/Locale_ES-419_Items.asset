    Value: "SE\xD1ALA LA CARTA QUE VAS A MOSTRAR"
  - Key: item.mutual_reveal.prompt_player
    Value: "SE\xD1ALA A QUIEN MOSTRAR\xC1 UNA CONTIGO"
  - Key: item.mutual_reveal.response
    Value: "QUIERE QUE MUESTRES UNA CARTA: SE\xD1ALA UNA"
  - Key: item.pair_lock_fold.name
    Value: Esposas
  - Key: item.pair_lock_fold.description
    Value: "T\xFA y el jugador elegido no pueden retirarse en la siguiente ronda."
  - Key: item.pair_lock_fold.notice
    Value: SE ESPOSA CON
  - Key: item.pair_lock_items.name
    Value: Sin objetos
  - Key: item.pair_lock_items.description
