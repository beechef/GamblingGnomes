  - Key: item.place_on_board.notice
    Value: BAJA UNA CARTA
  - Key: item.place_on_board.prompt
    Value: "SE\xD1ALA LA CARTA QUE DEJAS EN LA MESA"
  - Key: item.raise_stakes.name
    Value: Subida
  - Key: item.raise_stakes.description
    Value: "Cada apuesta de la siguiente ronda pone un hongo m\xE1s, la tuya incluida."
