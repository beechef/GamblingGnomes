  - Key: item.pair_lock_items.notice
    Value: BLOQUEA LOS OBJETOS DE
  - Key: item.pair_lock.prompt
    Value: "SE\xD1ALA A QUIEN QUEDA BLOQUEADO CONTIGO"
  - Key: item.peek_board.name
    Value: "Esp\xE1tula"
  - Key: item.peek_board.description
    Value: Mira una carta de la mesa antes de que se voltee. No puedes retirarte
