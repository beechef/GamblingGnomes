  - Key: item.copy_card.notice
    Value: INTENTA COPIAR
  - Key: item.copy_card.copied
    Value: LOGRA COPIAR
  - Key: item.copy_card.failed
    Value: FALLA LA COPIA
  - Key: item.deck_count.name
    Value: Contar palos
  - Key: item.deck_count.description
    Value: "Mira cu\xE1ntas cartas de cada palo, y cu\xE1ntos comodines si el mazo
