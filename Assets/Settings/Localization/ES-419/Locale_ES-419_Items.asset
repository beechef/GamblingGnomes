    Value: SUBE LA APUESTA
  - Key: item.random_suit.name
    Value: Dado
  - Key: item.random_suit.description
    Value: Una de tus cartas conserva su valor y cambia a otro palo al azar.
  - Key: item.random_suit.notice
    Value: CAMBIA DE PALO
  - Key: item.random_suit.prompt
    Value: "SE\xD1ALA LA CARTA QUE QUIERES CAMBIAR"
  - Key: item.rate_shift.name
    Value: Calzones
  - Key: item.rate_shift.description
    Value: 'Elige a un jugador: su riesgo de muerte sube o baja {0}, al azar.'
  - Key: item.rate_shift.raised
    Value: SUBE {0} LA DOSIS DE
  - Key: item.rate_shift.lowered
    Value: BAJA {0} LA DOSIS DE
  - Key: item.rate_shift.prompt
    Value: "SE\xD1ALA A QUIEN LE ALTERAS LA DOSIS"
  - Key: item.shared_roll.name
    Value: Cerveza
  - Key: item.shared_roll.description
    Value: "T\xFA y el jugador que elijas tiran al mismo tiempo, cada uno contra
