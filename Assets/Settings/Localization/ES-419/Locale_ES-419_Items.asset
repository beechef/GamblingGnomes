  - Key: item.peek_hand.notice
    Value: "ESP\xCDA A"
  - Key: item.place_on_board.name
    Value: Cigarrillo
  - Key: item.place_on_board.description
    Value: Pon una de tus cartas boca arriba en la mesa para todos y roba una nueva
