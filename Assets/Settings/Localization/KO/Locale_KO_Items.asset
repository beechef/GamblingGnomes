      \uAC78\uB9BD\uB2C8\uB2E4."
  - Key: item.raise_stakes.notice
    Value: "\uB2D8\uC774 \uD310\uB3C8 \uC62C\uB9BC"
  - Key: item.random_suit.name
    Value: "\uC8FC\uC0AC\uC704"
  - Key: item.random_suit.description
    Value: "\uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC774 \uC22B\uC790\uB294 \uADF8\uB300\uB85C,
      \uBB34\uC791\uC704\uB85C \uB2E4\uB978 \uBB34\uB2AC\uB85C \uBC14\uB01D\uB2C8\uB2E4."
  - Key: item.random_suit.notice
    Value: "\uB2D8\uC774 \uBB34\uB2AC\uB97C \uBC14\uAFC8"
  - Key: item.random_suit.prompt
    Value: "\uBC14\uAFC0 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.rate_shift.name
    Value: "\uD32C\uD2F0"
  - Key: item.rate_shift.description
    Value: "\uD50C\uB808\uC774\uC5B4 \uD55C \uBA85 \uC120\uD0DD: \uC0AC\uB9DD\uB960\uC774
      \uBB34\uC791\uC704\uB85C 20 \uC624\uB974\uAC70\uB098 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  - Key: item.rate_shift.raised
    Value: "\uB2D8\uC774 \uC0AC\uB9DD\uB960 +{0} \u2192"
  - Key: item.rate_shift.lowered
    Value: "\uB2D8\uC774 \uC0AC\uB9DD\uB960 -{0} \u2192"
  - Key: item.rate_shift.prompt
    Value: "\uC0AC\uB9DD\uB960\uC744 \uD754\uB4E4 \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.shared_roll.name
    Value: "\uB9E5\uC8FC"
  - Key: item.shared_roll.description
    Value: "\uB098\uC640 \uACE0\uB978 \uD50C\uB808\uC774\uC5B4\uAC00 \uAC01\uC790
      \uC790\uC2E0\uC758 \uC0AC\uB9DD\uB960\uB85C \uB3D9\uC2DC\uC5D0 \uAD74\uB9BD\uB2C8\uB2E4."
  - Key: item.shared_roll.notice
    Value: "\uB2D8\uC774 \uD568\uAED8 \uAD74\uB9BC \u2192"
  - Key: item.shared_roll.prompt
    Value: "\uD568\uAED8 \uAD74\uB9B4 \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_board.name
    Value: "\uB2F4\uBC30"
  - Key: item.swap_board.description
    Value: "\uB4B7\uBA74\uC778 \uBCF4\uB4DC \uCE74\uB4DC \uD55C \uC7A5\uC774 \uBAA8\uB450\uC5D0\uAC8C
      \uACF5\uAC1C\uB41C \uB4A4 \uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uACFC \uAD50\uD658\uB429\uB2C8\uB2E4.
      \uB0B8 \uCE74\uB4DC\uB294 \uBCF4\uB4DC\uC5D0 \uC55E\uBA74\uC73C\uB85C \uB0A8\uC2B5\uB2C8\uB2E4."
  - Key: item.swap_board.notice
    Value: "\uB2D8\uC774 \uBCF4\uB4DC \uCE74\uB4DC \uAD50\uD658"
  - Key: item.swap_board.prompt
    Value: "\uBCF4\uB4DC\uC5D0 \uB0BC \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.name
    Value: "\uCE7C"
  - Key: item.swap_hand.description
    Value: "\uD578\uB4DC\uC5D0 \uB0A8\uC740 \uD50C\uB808\uC774\uC5B4\uC640 \uCE74\uB4DC
      \uD55C \uC7A5\uC744 \uAD50\uD658\uD569\uB2C8\uB2E4. \uC904 \uCE74\uB4DC\uB294
      \uC0C1\uB300\uAC00 \uACE0\uB985\uB2C8\uB2E4."
  - Key: item.swap_hand.notice
    Value: "\uB2D8\uC774 \uCE74\uB4DC \uAD50\uD658 \u2192"
  - Key: item.swap_hand.prompt_own
    Value: "\uC904 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.prompt_player
    Value: "\uAD50\uD658\uD560 \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.response
    Value: "\uB2D8\uC774 \uCE74\uB4DC \uAD50\uD658\uC744 \uC694\uCCAD - \uAD50\uD658\uD560
      \uCE74\uB4DC\uB97C \uACE0\uB974\uC138\uC694"
  - Key: item.table_reveal.name
    Value: "\uD655\uC131\uAE30"
  - Key: item.table_reveal.description
    Value: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uD578\uB4DC\uC5D0 \uB0A8\uC740
      \uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uAC00 \uBB34\uC791\uC704 \uCE74\uB4DC
      \uD55C \uC7A5\uC744 \uD14C\uC774\uBE14 \uC804\uCCB4\uC5D0 \uACF5\uAC1C\uD569\uB2C8\uB2E4."
  - Key: item.table_reveal.notice
    Value: "\uB2D8\uC774 \uC804\uC6D0 \uCE74\uB4DC \uD3ED\uB85C"
