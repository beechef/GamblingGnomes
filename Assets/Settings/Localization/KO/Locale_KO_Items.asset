    Value: "\uC0AC\uB9DD\uB960\uC744 \uBC18\uAC10\uD560 \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.joker_card.name
    Value: "\uAE5C\uC9DD \uC0C1\uC790"
  - Key: item.joker_card.description
    Value: "\uACE0\uB978 \uCE74\uB4DC \uD55C \uC7A5\uC774 50% \uD655\uB960\uB85C
      \uC870\uCEE4\uAC00 \uB429\uB2C8\uB2E4. \uC131\uACF5 \uC5EC\uBD80\uB294 \uB098\uB9CC
      \uC555\uB2C8\uB2E4."
  - Key: item.joker_card.joker
    Value: "\uB2D8\uC774 \uC870\uCEE4 \uD68D\uB4DD"
  - Key: item.joker_card.failed
    Value: "\uB2D8\uC774 \uC870\uCEE4 \uC2E4\uD328"
