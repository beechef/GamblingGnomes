  - Key: item.extra_draw.notice
    Value: "\uB2D8\uC774 \uCD94\uAC00 \uB4DC\uB85C\uC6B0"
  - Key: item.half_dose.name
    Value: "\uC8FC\uC0AC\uAE30"
  - Key: item.half_dose.description
    Value: "\uD50C\uB808\uC774\uC5B4 \uD55C \uBA85 \uC120\uD0DD: \uC0AC\uB9DD\uB960\uC774
