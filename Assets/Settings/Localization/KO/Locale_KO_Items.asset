  - Key: item.pair_lock.prompt
    Value: "\uD568\uAED8 \uBB36\uC77C \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.peek_board.name
    Value: "\uB4A4\uC9D1\uAC1C"
  - Key: item.peek_board.description
    Value: "\uACF5\uAC1C\uB418\uAE30 \uC804\uC758 \uBCF4\uB4DC \uCE74\uB4DC \uD55C
      \uC7A5\uC744 \uBD05\uB2C8\uB2E4. \uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0\uB294
      \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.peek_board.notice
    Value: "\uB2D8\uC774 \uBCF4\uB4DC \uC5FF\uBD04"
  - Key: item.peek_board_main.description
    Value: "\uB9C8\uC9C0\uB9C9 \uBCF4\uB4DC \uCE74\uB4DC\uB97C \uACF5\uAC1C\uB418\uAE30
      \uC804\uC5D0 \uBD05\uB2C8\uB2E4. \uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0\uB294
      \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.peek_hand.name
    Value: "\uC5FF\uBCF4\uAE30"
  - Key: item.peek_hand.description
    Value: "\uD578\uB4DC\uC5D0 \uB0A8\uC740 \uD50C\uB808\uC774\uC5B4\uC758 \uCE74\uB4DC
      \uD55C \uC7A5\uC744 \uBD05\uB2C8\uB2E4. \uC5B4\uB5A4 \uCE74\uB4DC\uB97C \uBD24\uB294\uC9C0
      \uC0C1\uB300\uC5D0\uAC8C \uC54C\uB824\uC9D1\uB2C8\uB2E4."
  - Key: item.peek_hand.notice
    Value: "\uB2D8\uC774 \uC5FF\uBD04 \u2192"
  - Key: item.peek_hand.private
    Value: "\uB2D8\uC774 \uB0B4 {0} \uCE74\uB4DC\uB97C \uBD04"
  - Key: item.place_on_board.name
    Value: "\uB2F4\uBC30"
  - Key: item.place_on_board.description
    Value: "\uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC744 \uBCF4\uB4DC\uC5D0 \uC55E\uBA74\uC73C\uB85C
