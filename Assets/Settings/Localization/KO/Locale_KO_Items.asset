    Value: "\uBC84\uC12F\uC5D0 \uC57D\uC744 \uD0C8 \uC0C1\uB300\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.mutual_reveal.name
    Value: "\uD568\uAED8 \uACF5\uAC1C"
  - Key: item.mutual_reveal.description
    Value: "\uB098\uC640 \uACE0\uB978 \uD50C\uB808\uC774\uC5B4\uAC00 \uAC01\uC790
      \uCE74\uB4DC \uD55C \uC7A5\uC744 \uD578\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0
      \uBAA8\uB450\uC5D0\uAC8C \uACF5\uAC1C\uD569\uB2C8\uB2E4. \uC0C1\uB300\uB294
      \uC790\uAE30 \uCE74\uB4DC \uC911 \uBB34\uC5C7\uC744 \uACF5\uAC1C\uD560\uC9C0
      \uACE0\uB985\uB2C8\uB2E4."
  - Key: item.mutual_reveal.notice
    Value: "\uB2D8\uC774 \uD568\uAED8 \uACF5\uAC1C \u2192"
