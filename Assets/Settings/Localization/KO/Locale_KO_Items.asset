  - Key: item.prompt.own_card
    Value: "\uB0B4 \uCE74\uB4DC \uC911 \uD55C \uC7A5\uC744 \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.prompt.board_card
    Value: "\uB4B7\uBA74\uC778 \uBCF4\uB4DC \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.reason.not_dealt
    Value: "\uC774 \uC544\uC774\uD15C\uC740 \uC774 \uB9E4\uCE58\uC5D0\uC11C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.not_held
    Value: "\uC774 \uC544\uC774\uD15C\uC744 \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.out_of_match
    Value: "\uC774 \uB9E4\uCE58\uC5D0\uC11C \uD0C8\uB77D\uD588\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.street_only
    Value: "\uBCA0\uD305 \uB77C\uC6B4\uB4DC \uC911\uC5D0\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - Key: item.reason.turn_only
    Value: "\uB0B4 \uD134\uC5D0\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - Key: item.reason.locked_out
    Value: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0\uB294 \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.used_one
    Value: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uC774\uBBF8 \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD588\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.used_many
    Value: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uC774\uBBF8 \uC544\uC774\uD15C\uC744
      {0}\uAC1C \uC0AC\uC6A9\uD588\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.waiting_other
    Value: "\uB2E4\uB978 \uC544\uC774\uD15C\uC774 \uB05D\uB098\uAE30\uB97C \uAE30\uB2E4\uB9AC\uB294
      \uC911\uC785\uB2C8\uB2E4."
  - Key: item.reason.not_in_hand
    Value: "\uC774\uBC88 \uD578\uB4DC\uC5D0 \uCC38\uC5EC\uD558\uACE0 \uC788\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.hand_full
    Value: "\uC544\uC774\uD15C \uC2AC\uB86F\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.deck_empty
    Value: "\uB371\uC774 \uBE44\uC5C8\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.no_street_left
    Value: "\uC774\uBC88 \uD578\uB4DC\uC5D0 \uB0A8\uC740 \uB77C\uC6B4\uB4DC\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.no_board
    Value: "\uC774 \uB9E4\uCE58\uC5D0\uB294 \uBCF4\uB4DC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.last_board_seen
    Value: "\uB9C8\uC9C0\uB9C9 \uBCF4\uB4DC \uCE74\uB4DC\uB97C \uC774\uBBF8 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.board_seen
    Value: "\uBAA8\uB4E0 \uBCF4\uB4DC \uCE74\uB4DC\uB97C \uC774\uBBF8 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.board_full
    Value: "\uBCF4\uB4DC\uAC00 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.no_card_to_lay
    Value: "\uB0B4\uB824\uB193\uC744 \uCE74\uB4DC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.no_card_to_give
    Value: "\uC904 \uC218 \uC788\uB294 \uCE74\uB4DC\uAC00 \uB0A8\uC544 \uC788\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.all_face_up
    Value: "\uBAA8\uB4E0 \uCE74\uB4DC\uAC00 \uC774\uBBF8 \uC55E\uBA74\uC785\uB2C8\uB2E4."
  - Key: item.reason.cant_change
    Value: "\uB0B4 \uCE74\uB4DC\uB294 \uC5B4\uB290 \uAC83\uB3C4 \uBC14\uAFC0 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.already_under
    Value: "\uC774\uBBF8 \uACFC\uB2E4 \uBCF5\uC6A9 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
  - Key: item.reason.nobody_to_halve
    Value: "\uD658\uAC01 \uC218\uCE58\uB97C \uC808\uBC18\uC73C\uB85C \uC904\uC77C
      \uB300\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.nobody_in_hand
    Value: "\uC774\uBC88 \uD578\uB4DC\uC5D0 \uB0A8\uC740 \uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.nobody_to_shake
    Value: "\uB300\uC0C1\uC73C\uB85C \uC0BC\uC744 \uD50C\uB808\uC774\uC5B4\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.nobody_to_roll
    Value: "\uB370\uC2A4 \uB864\uC744 \uD560 \uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.reason.nobody_to_swap
    Value: "\uAD50\uD658\uD560 \uCE74\uB4DC\uB97C \uAC00\uC9C4 \uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.copy_card.name
    Value: "\uBCF5\uC0AC"
  - Key: item.copy_card.description
    Value: "\uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC774 \uB0B4 \uB2E4\uB978 \uCE74\uB4DC\uC758
      \uBCF5\uC0AC\uBCF8\uC774 \uB420 \uD655\uB960\uC774 35%\uC785\uB2C8\uB2E4."
  - Key: item.copy_card.notice
    Value: "\uBCF5\uC0AC \uC2DC\uB3C4"
  - Key: item.copy_card.copied
    Value: "\uBCF5\uC0AC \uC131\uACF5"
  - Key: item.copy_card.failed
    Value: "\uBCF5\uC0AC \uC2E4\uD328"
  - Key: item.deck_count.name
    Value: "\uBB34\uB2AC \uC138\uAE30"
  - Key: item.deck_count.description
    Value: "\uB371\uC5D0 \uB0A8\uC544 \uC788\uB294 \uBB34\uB2AC\uBCC4 \uCE74\uB4DC
      \uC218\uC640, \uC870\uCEE4\uAC00 \uC788\uB2E4\uBA74 \uC870\uCEE4 \uC218\uB3C4
      \uD655\uC778\uD569\uB2C8\uB2E4. \uB098\uB9CC \uBCFC \uC218 \uC788\uC73C\uBA70
      \uC774\uBC88 \uD578\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - Key: item.deck_count.notice
    Value: "\uB371\uC744 \uC14C\uB2E4"
  - Key: item.extra_draw.name
    Value: "\uAD6C\uD1A0"
  - Key: item.extra_draw.description
    Value: "\uB371\uC5D0\uC11C \uCE74\uB4DC\uB97C \uD55C \uC7A5 \uB354 \uBF51\uC2B5\uB2C8\uB2E4.
      \uC774\uBC88 \uD578\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uD3F4\uB4DC\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.extra_draw.notice
    Value: "\uCE74\uB4DC \uD55C \uC7A5 \uBF51\uC74C"
  - Key: item.half_dose.name
    Value: "\uC8FC\uC0AC\uAE30"
  - Key: item.half_dose.description
    Value: "\uD50C\uB808\uC774\uC5B4 \uD55C \uBA85\uC744 \uACE0\uB985\uB2C8\uB2E4.
      \uADF8 \uD50C\uB808\uC774\uC5B4\uC758 \uD658\uAC01 \uC218\uCE58\uAC00 \uC601\uAD6C\uC801\uC73C\uB85C
      \uC808\uBC18\uC774 \uB418\uACE0, \uC774\uD6C4 \uB370\uC2A4 \uB864\uC744 \uD569\uB2C8\uB2E4."
  - Key: item.half_dose.notice
    Value: "\uD658\uAC01 \uC218\uCE58 \uBC18\uAC10 \u2192"
  - Key: item.half_dose.prompt
    Value: "\uD658\uAC01 \uC218\uCE58\uB97C \uC808\uBC18\uC73C\uB85C \uC904\uC77C
      \uD50C\uB808\uC774\uC5B4\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.joker_card.name
    Value: "\uAE5C\uC9DD \uC0C1\uC790"
  - Key: item.joker_card.description
    Value: "\uB0B4\uAC00 \uACE0\uB978 \uCE74\uB4DC \uD55C \uC7A5\uC774 {0}% \uD655\uB960\uB85C
      \uC870\uCEE4\uAC00 \uB429\uB2C8\uB2E4. \uACB0\uACFC\uB294 \uB098\uB9CC \uC54C
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Key: item.joker_card.joker
    Value: "\uC870\uCEE4 \uD68D\uB4DD"
  - Key: item.joker_card.failed
    Value: "\uC870\uCEE4 \uC2E4\uD328"
  - Key: item.lock_fold.name
    Value: "\uC790\uBB3C\uC1E0"
  - Key: item.lock_fold.description
    Value: "\uB2E4\uC74C \uB77C\uC6B4\uB4DC\uC5D0\uC11C\uB294 \uB098\uB97C \uD3EC\uD568\uD55C
      \uB204\uAD6C\uB3C4 \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.lock_fold.notice
    Value: "\uD3F4\uB4DC \uC7A0\uAE08"
  - Key: item.mushroom_dose.name
    Value: "\uC57D \uD0C0\uAE30"
  - Key: item.mushroom_dose.description
    Value: "\uC120\uD0DD\uD55C \uD50C\uB808\uC774\uC5B4\uAC00 \uB2E4\uC74C\uC5D0
      \uBA39\uB294 \uBC84\uC12F 2\uAC1C\uB294 \uD6A8\uACFC\uAC00 \uC5C6\uAC70\uB098
      \uD6A8\uACFC\uAC00 \uB450 \uBC30\uAC00 \uB429\uB2C8\uB2E4 (50/50)."
  - Key: item.mushroom_dose.notice
    Value: "\uC57D\uC744 \uD0D4\uB2E4 \u2192"
  - Key: item.mushroom_dose.prompt
    Value: "\uBC84\uC12F\uC5D0 \uC57D\uC744 \uD0C8 \uD50C\uB808\uC774\uC5B4\uB97C
      \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.mutual_reveal.name
    Value: "\uD568\uAED8 \uACF5\uAC1C"
  - Key: item.mutual_reveal.description
    Value: "\uB098\uC640 \uB0B4\uAC00 \uACE0\uB978 \uD50C\uB808\uC774\uC5B4\uAC00
      \uAC01\uC790 \uCE74\uB4DC \uD55C \uC7A5\uC744 \uC55E\uBA74\uC73C\uB85C \uACF5\uAC1C\uD558\uBA70,
      \uC774\uBC88 \uD578\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uBAA8\uB450\uC5D0\uAC8C
      \uBCF4\uC785\uB2C8\uB2E4. \uC0C1\uB300\uB294 \uC790\uC2E0\uC758 \uC5B4\uB5A4
      \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD560\uC9C0 \uC9C1\uC811 \uACE0\uB985\uB2C8\uB2E4."
  - Key: item.mutual_reveal.notice
    Value: "\uD568\uAED8 \uACF5\uAC1C \u2192"
  - Key: item.mutual_reveal.prompt_own
    Value: "\uACF5\uAC1C\uD560 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.mutual_reveal.prompt_player
    Value: "\uD568\uAED8 \uACF5\uAC1C\uD560 \uD50C\uB808\uC774\uC5B4\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.mutual_reveal.response
    Value: "\uCE74\uB4DC \uACF5\uAC1C\uB97C \uC694\uCCAD\uD588\uC2B5\uB2C8\uB2E4:
      \uD55C \uC7A5\uC744 \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.pair_lock_fold.name
    Value: "\uC218\uAC11"
  - Key: item.pair_lock_fold.description
    Value: "\uB098\uC640 \uC120\uD0DD\uD55C \uD50C\uB808\uC774\uC5B4\uB294 \uB2E4\uC74C
      \uB77C\uC6B4\uB4DC\uC5D0\uC11C \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.pair_lock_fold.notice
    Value: "\uC218\uAC11 \uCC44\uC6C0 \u2192"
  - Key: item.pair_lock_items.name
    Value: "\uC544\uC774\uD15C \uAE08\uC9C0"
  - Key: item.pair_lock_items.description
    Value: "\uB098\uC640 \uC120\uD0DD\uD55C \uD50C\uB808\uC774\uC5B4\uB294 \uB2E4\uC74C
      \uB77C\uC6B4\uB4DC\uC5D0\uC11C \uC544\uC774\uD15C\uC744 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.pair_lock_items.notice
    Value: "\uC544\uC774\uD15C \uBD09\uC778 \u2192"
  - Key: item.pair_lock.prompt
    Value: "\uB098\uC640 \uD568\uAED8 \uC81C\uD55C\uB420 \uD50C\uB808\uC774\uC5B4\uB97C
      \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.peek_board.name
    Value: "\uB4A4\uC9D1\uAC1C"
  - Key: item.peek_board.description
    Value: "\uACF5\uAC1C\uB418\uAE30 \uC804\uC758 \uBCF4\uB4DC \uCE74\uB4DC \uD55C
      \uC7A5\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. \uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0\uB294
      \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.peek_board.notice
    Value: "\uBCF4\uB4DC\uB97C \uD6D4\uCCD0\uBD04"
  - Key: item.peek_board_main.description
    Value: "\uACF5\uAC1C\uB418\uAE30 \uC804\uC758 \uB9C8\uC9C0\uB9C9 \uBCF4\uB4DC
      \uCE74\uB4DC\uB97C \uD655\uC778\uD569\uB2C8\uB2E4. \uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0\uB294
      \uD3F4\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - Key: item.peek_hand.name
    Value: "\uD6D4\uCCD0\uBCF4\uAE30"
  - Key: item.peek_hand.description
    Value: "\uC544\uC9C1 \uD578\uB4DC\uC5D0 \uB0A8\uC544 \uC788\uB294 \uD50C\uB808\uC774\uC5B4\uC758
      \uCE74\uB4DC \uD55C \uC7A5\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. \uC0C1\uB300\uC5D0\uAC8C
      \uC5B4\uB5A4 \uCE74\uB4DC\uB97C \uBD24\uB294\uC9C0 \uC54C\uB824\uC9D1\uB2C8\uB2E4."
  - Key: item.peek_hand.notice
    Value: "\uD6D4\uCCD0\uBD04"
  - Key: item.place_on_board.name
    Value: "\uB2F4\uBC30"
  - Key: item.place_on_board.description
    Value: "\uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC744 \uBAA8\uB450\uAC00 \uBCFC \uC218
      \uC788\uAC8C \uBCF4\uB4DC\uC5D0 \uC55E\uBA74\uC73C\uB85C \uB0B4\uB824\uB193\uACE0,
      \uB300\uC2E0 \uB371\uC5D0\uC11C \uC0C8 \uCE74\uB4DC\uB97C \uD55C \uC7A5 \uBF51\uC2B5\uB2C8\uB2E4."
  - Key: item.place_on_board.notice
    Value: "\uCE74\uB4DC \uB0B4\uB824\uB193\uC74C"
  - Key: item.place_on_board.prompt
    Value: "\uBCF4\uB4DC\uC5D0 \uB0B4\uB824\uB193\uC744 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.raise_stakes.name
    Value: "\uB808\uC774\uC988"
  - Key: item.raise_stakes.description
    Value: "\uB2E4\uC74C \uB77C\uC6B4\uB4DC\uC758 \uBAA8\uB4E0 \uBCA0\uD305\uC5D0
      \uBC84\uC12F\uC774 \uD558\uB098\uC529 \uCD94\uAC00\uB429\uB2C8\uB2E4. \uB0B4
      \uBCA0\uD305\uB3C4 \uD3EC\uD568\uC785\uB2C8\uB2E4."
  - Key: item.raise_stakes.notice
    Value: "\uD310\uB3C8 \uC778\uC0C1"
  - Key: item.random_suit.name
    Value: "\uC8FC\uC0AC\uC704"
  - Key: item.random_suit.description
    Value: "\uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC758 \uC22B\uC790\uB294 \uADF8\uB300\uB85C\uC774\uACE0,
      \uBB34\uB2AC\uAC00 \uBB34\uC791\uC704\uB85C \uB2E4\uB978 \uBB34\uB2AC\uB85C
      \uBC14\uB01D\uB2C8\uB2E4."
  - Key: item.random_suit.notice
    Value: "\uBB34\uB2AC \uBCC0\uACBD"
  - Key: item.random_suit.prompt
    Value: "\uBC14\uAFC0 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.rate_shift.name
    Value: "\uD32C\uD2F0"
  - Key: item.rate_shift.description
    Value: "\uD50C\uB808\uC774\uC5B4 \uD55C \uBA85\uC744 \uACE0\uB985\uB2C8\uB2E4.
      \uADF8 \uD50C\uB808\uC774\uC5B4\uC758 \uD658\uAC01 \uC218\uCE58\uAC00 \uBB34\uC791\uC704\uB85C
      {0}% \uC624\uB974\uAC70\uB098 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  - Key: item.rate_shift.raised
    Value: "\uD658\uAC01 \uC218\uCE58 +{0}% \u2192"
  - Key: item.rate_shift.lowered
    Value: "\uD658\uAC01 \uC218\uCE58 -{0}% \u2192"
  - Key: item.rate_shift.prompt
    Value: "\uD658\uAC01 \uC218\uCE58\uB97C \uBC14\uAFC0 \uD50C\uB808\uC774\uC5B4\uB97C
      \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.shared_roll.name
    Value: "\uB9E5\uC8FC"
  - Key: item.shared_roll.description
    Value: "\uB098\uC640 \uB0B4\uAC00 \uACE0\uB978 \uD50C\uB808\uC774\uC5B4\uAC00
      \uB3D9\uC2DC\uC5D0 \uAC01\uC790\uC758 \uD658\uAC01 \uC218\uCE58\uB85C \uB370\uC2A4
      \uB864\uC744 \uD569\uB2C8\uB2E4."
  - Key: item.shared_roll.notice
    Value: "\uD568\uAED8 \uB370\uC2A4 \uB864 \u2192"
  - Key: item.shared_roll.prompt
    Value: "\uB098\uC640 \uD568\uAED8 \uB370\uC2A4 \uB864\uC744 \uD560 \uD50C\uB808\uC774\uC5B4\uB97C
      \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_board.name
    Value: "\uB2F4\uBC30"
  - Key: item.swap_board.description
    Value: "\uB4B7\uBA74\uC778 \uBCF4\uB4DC \uCE74\uB4DC \uD55C \uC7A5\uC774 \uBAA8\uB450\uC5D0\uAC8C
      \uACF5\uAC1C\uB41C \uB4A4, \uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uACFC \uAD50\uD658\uB429\uB2C8\uB2E4.
      \uB0B4 \uCE74\uB4DC\uB294 \uC55E\uBA74\uC778 \uCC44\uB85C \uBCF4\uB4DC\uC5D0
      \uB0A8\uC2B5\uB2C8\uB2E4."
  - Key: item.swap_board.notice
    Value: "\uBCF4\uB4DC \uCE74\uB4DC \uAD50\uD658"
  - Key: item.swap_board.prompt
    Value: "\uBCF4\uB4DC\uC5D0 \uC62C\uB9B4 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.name
    Value: "\uCE7C"
  - Key: item.swap_hand.description
    Value: "\uC544\uC9C1 \uD578\uB4DC\uC5D0 \uB0A8\uC544 \uC788\uB294 \uD50C\uB808\uC774\uC5B4\uC640
      \uB0B4 \uCE74\uB4DC \uD55C \uC7A5\uC744 \uAD50\uD658\uD569\uB2C8\uB2E4. \uC0C1\uB300\uAC00
      \uC790\uC2E0\uC758 \uC5B4\uB5A4 \uCE74\uB4DC\uB97C \uC904\uC9C0 \uC9C1\uC811
      \uACE0\uB985\uB2C8\uB2E4."
  - Key: item.swap_hand.notice
    Value: "\uAD50\uD658 \u2192"
  - Key: item.swap_hand.prompt_own
    Value: "\uC904 \uCE74\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.prompt_player
    Value: "\uAD50\uD658\uD560 \uD50C\uB808\uC774\uC5B4\uB97C \uAC00\uB9AC\uD0A4\uC138\uC694"
  - Key: item.swap_hand.response
    Value: "\uB2D8\uC774 \uCE74\uB4DC \uAD50\uD658\uC744 \uC6D0\uD569\uB2C8\uB2E4:
      \uC904 \uCE74\uB4DC\uB97C \uACE0\uB974\uC138\uC694"
  - Key: item.table_reveal.name
    Value: "\uD655\uC131\uAE30"
  - Key: item.table_reveal.description
    Value: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uC544\uC9C1 \uD578\uB4DC\uC5D0
      \uB0A8\uC544 \uC788\uB294 \uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uAC00 \uBB34\uC791\uC704
      \uCE74\uB4DC \uD55C \uC7A5\uC744 \uBAA8\uB450\uC5D0\uAC8C \uACF5\uAC1C\uD569\uB2C8\uB2E4."
  - Key: item.table_reveal.notice
    Value: "\uBAA8\uB450\uC5D0\uAC8C \uCE74\uB4DC \uACF5\uAC1C\uB97C \uC2DC\uCF30\uB2E4"
  - Key: item.reason.no_time
    Value: "\uC0C1\uB300\uAC00 \uC751\uB2F5\uD560 \uC2DC\uAC04\uC774 \uCDA9\uBD84\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
