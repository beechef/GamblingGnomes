  - Key: item.deck_count.name
    Value: "\uBB34\uB2AC \uCE74\uC6B4\uD2B8"
  - Key: item.deck_count.description
    Value: "\uC544\uC9C1 \uB098\uB220\uC8FC\uC9C0 \uC54A\uC740 \uB371\uC5D0 \uBB34\uB2AC\uBCC4\uB85C
      \uBA87 \uC7A5, \uC870\uCEE4\uAC00 \uC788\uB294 \uB371\uC774\uB77C\uBA74 \uC870\uCEE4\uAC00
      \uBA87 \uC7A5 \uB0A8\uC558\uB294\uC9C0 \uBD05\uB2C8\uB2E4. \uACB0\uACFC\uB294
      \uB098\uB9CC \uBCF4\uBA70 \uD578\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0
      \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - Key: item.deck_count.notice
    Value: "\uB2D8\uC774 \uB371 \uCE74\uC6B4\uD2B8"
  - Key: item.extra_draw.name
    Value: "\uAD6C\uD1A0"
  - Key: item.extra_draw.description
    Value: "\uB371\uC5D0\uC11C \uCE74\uB4DC\uB97C \uD55C \uC7A5 \uB354 \uBF51\uC2B5\uB2C8\uB2E4.
