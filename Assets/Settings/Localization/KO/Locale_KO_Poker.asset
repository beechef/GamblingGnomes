  - Key: poker.define.meter_description
    Value: "\uBC84\uC12F\uC744 \uD558\uB098 \uBA39\uC744 \uB54C\uB9C8\uB2E4 \uD658\uAC01\uC774
      10% \uC624\uB985\uB2C8\uB2E4. \uC218\uCE58\uAC00 \uB192\uC744\uC218\uB85D \uB354
      \uB9CE\uC740 \uD6A8\uACFC\uAC00 \uB098\uD0C0\uB0A9\uB2C8\uB2E4. 100%\uAC00
      \uB418\uBA74 \uACFC\uB2E4 \uBCF5\uC6A9\uC73C\uB85C \uD328\uBC30\uD569\uB2C8\uB2E4."
