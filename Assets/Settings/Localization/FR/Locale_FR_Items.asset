  m_Name: Locale_FR_Items
  m_EditorClassIdentifier: Localization::Localization.LocaleSection
  _entries:
  - Key: item.prompt.player
    Value: "D\xC9SIGNEZ UN JOUEUR"
  - Key: item.prompt.opponent_card
    Value: "D\xC9SIGNEZ LA CARTE D'UN AUTRE JOUEUR"
  - Key: item.prompt.own_card
    Value: "D\xC9SIGNEZ UNE DE VOS CARTES"
  - Key: item.prompt.board_card
    Value: "D\xC9SIGNEZ UNE CARTE DU BOARD FACE CACH\xC9E"
  - Key: item.reason.not_dealt
    Value: Cet objet n'est pas disponible dans cette partie.
  - Key: item.reason.not_held
    Value: Vous n'avez pas cet objet.
  - Key: item.reason.out_of_match
    Value: "Vous \xEAtes hors de cette partie."
  - Key: item.reason.street_only
    Value: "Uniquement pendant un tour d'ench\xE8res."
  - Key: item.reason.turn_only
    Value: "Uniquement \xE0 votre tour."
  - Key: item.reason.locked_out
    Value: "Les objets sont verrouill\xE9s pour ce tour."
  - Key: item.reason.used_one
    Value: "Vous avez d\xE9j\xE0 utilis\xE9 un objet ce tour."
  - Key: item.reason.used_many
    Value: "Vous avez d\xE9j\xE0 utilis\xE9 {0} objets ce tour."
  - Key: item.reason.waiting_other
    Value: En attente de la fin d'un autre objet.
  - Key: item.reason.not_in_hand
    Value: "Vous ne participez pas \xE0 cette donne."
  - Key: item.reason.hand_full
    Value: Vos emplacements d'objets sont pleins.
  - Key: item.reason.deck_empty
    Value: Le paquet est vide.
  - Key: item.reason.no_street_left
    Value: Il ne reste aucun tour dans cette donne.
  - Key: item.reason.no_board
    Value: Il n'y a pas de board dans cette partie.
  - Key: item.reason.last_board_seen
    Value: "Vous avez d\xE9j\xE0 vu la derni\xE8re carte du board."
  - Key: item.reason.board_seen
    Value: "Vous avez d\xE9j\xE0 vu toutes les cartes du board."
  - Key: item.reason.board_full
    Value: Le board est complet.
  - Key: item.reason.no_card_to_lay
    Value: "Vous n'avez aucune carte \xE0 poser."
  - Key: item.reason.no_card_to_give
    Value: "Vous n'avez plus de carte \xE0 donner."
  - Key: item.reason.all_face_up
    Value: "Toutes les cartes sont d\xE9j\xE0 face visible."
  - Key: item.reason.cant_change
    Value: "Aucune de vos cartes ne peut \xEAtre modifi\xE9e."
  - Key: item.reason.already_under
    Value: "Vous \xEAtes d\xE9j\xE0 en overdose."
  - Key: item.reason.nobody_to_halve
    Value: "Personne n'a de taux d'hallucination \xE0 diviser par deux."
  - Key: item.reason.nobody_in_hand
    Value: Plus personne d'autre dans la donne.
  - Key: item.reason.nobody_to_shake
    Value: "Plus personne \xE0 cibler."
  - Key: item.reason.nobody_to_roll
    Value: Plus personne d'autre pour un Jet de la mort.
  - Key: item.reason.nobody_to_swap
    Value: "Personne d'autre n'a de carte \xE0 \xE9changer."
  - Key: item.copy_card.name
    Value: Copie
  - Key: item.copy_card.description
    Value: 35 % de chances qu'une de vos cartes devienne une copie d'une autre de
      vos cartes.
  - Key: item.copy_card.notice
    Value: "A TENT\xC9 UNE COPIE"
  - Key: item.copy_card.copied
    Value: "COPI\xC9"
  - Key: item.copy_card.failed
    Value: "COPIE \xC9CHOU\xC9E"
  - Key: item.deck_count.name
    Value: Compteur de couleurs
  - Key: item.deck_count.description
    Value: "Voyez combien de cartes de chaque couleur restent dans le paquet, ainsi
      que les Jokers s'il y en a. Vous seul voyez le compte, et vous le gardez jusqu'\xE0
      la fin de la donne."
  - Key: item.deck_count.notice
    Value: "A COMPT\xC9 LE PAQUET"
  - Key: item.extra_draw.name
    Value: Vomi
  - Key: item.extra_draw.description
    Value: "Piochez une carte de plus dans le paquet. Vous ne pouvez plus vous coucher
      jusqu'\xE0 la fin de cette donne."
  - Key: item.extra_draw.notice
    Value: "A PIOCH\xC9 UNE CARTE"
  - Key: item.half_dose.name
    Value: Seringue
  - Key: item.half_dose.description
    Value: "Choisissez un joueur : son taux d'hallucination est d\xE9finitivement
      divis\xE9 par deux, puis il fait un Jet de la mort."
  - Key: item.half_dose.notice
    Value: "A DIVIS\xC9 PAR DEUX L'HALLUCINATION DE"
  - Key: item.half_dose.prompt
    Value: "D\xC9SIGNEZ LE JOUEUR DONT VOUS DIVISEZ L'HALLUCINATION"
  - Key: item.joker_card.name
    Value: "Diable en bo\xEEte"
  - Key: item.joker_card.description
    Value: "Une carte de votre choix a {0} % de chances de devenir un Joker. Vous
      seul connaissez le r\xE9sultat."
  - Key: item.joker_card.joker
    Value: A OBTENU UN JOKER
  - Key: item.joker_card.failed
    Value: PAS DE JOKER
  - Key: item.lock_fold.name
    Value: Cadenas
  - Key: item.lock_fold.description
    Value: Personne ne peut se coucher au prochain tour, vous compris.
  - Key: item.lock_fold.notice
    Value: "COUCHER VERROUILL\xC9"
  - Key: item.mushroom_dose.name
    Value: Drogue
  - Key: item.mushroom_dose.description
    Value: Les 2 prochains champignons d'un joueur choisi n'ont aucun effet ou frappent
      deux fois plus fort, 50/50.
  - Key: item.mushroom_dose.notice
    Value: "A DROGU\xC9"
  - Key: item.mushroom_dose.prompt
    Value: "D\xC9SIGNEZ LE JOUEUR DONT VOUS DROGUEZ LES CHAMPIGNONS"
  - Key: item.mutual_reveal.name
    Value: "R\xE9v\xE9lation \xE0 deux"
  - Key: item.mutual_reveal.description
    Value: "Vous et un joueur de votre choix r\xE9v\xE9lez chacun une carte, face
      visible pour tous jusqu'\xE0 la fin de la donne. Il choisit laquelle des siennes."
  - Key: item.mutual_reveal.notice
    Value: "R\xC9V\xC8LE AVEC"
  - Key: item.mutual_reveal.prompt_own
    Value: "D\xC9SIGNEZ LA CARTE QUE VOUS ALLEZ R\xC9V\xC9LER"
  - Key: item.mutual_reveal.prompt_player
    Value: "D\xC9SIGNEZ QUI R\xC9V\xC8LE UNE CARTE AVEC VOUS"
  - Key: item.mutual_reveal.response
    Value: "VEUT QUE VOUS R\xC9V\xC9LIEZ UNE CARTE : D\xC9SIGNEZ-EN UNE"
  - Key: item.pair_lock_fold.name
    Value: Menottes
  - Key: item.pair_lock_fold.description
    Value: Vous et un joueur choisi ne pouvez pas vous coucher au prochain tour.
  - Key: item.pair_lock_fold.notice
    Value: "A MENOTT\xC9"
  - Key: item.pair_lock_items.name
    Value: Sans objets
  - Key: item.pair_lock_items.description
    Value: Vous et un joueur choisi ne pouvez pas utiliser d'objets au prochain tour.
  - Key: item.pair_lock_items.notice
    Value: "A BLOQU\xC9 LES OBJETS DE"
  - Key: item.pair_lock.prompt
    Value: "D\xC9SIGNEZ QUI SERA BLOQU\xC9 AVEC VOUS"
  - Key: item.peek_board.name
    Value: Spatule
  - Key: item.peek_board.description
    Value: "Voyez une carte du board avant qu'elle soit r\xE9v\xE9l\xE9e. Vous ne
      pouvez pas vous coucher ce tour."
  - Key: item.peek_board.notice
    Value: "A REGARD\xC9 LE BOARD"
  - Key: item.peek_board_main.description
    Value: "Voyez la derni\xE8re carte du board avant qu'elle soit r\xE9v\xE9l\xE9e.
      Vous ne pouvez pas vous coucher ce tour."
  - Key: item.peek_hand.name
    Value: "Coup d'\u0153il"
  - Key: item.peek_hand.description
    Value: "Voyez une carte d'un joueur encore dans la donne. Il est inform\xE9 de
      la carte que vous avez vue."
  - Key: item.peek_hand.notice
    Value: "A REGARD\xC9"
  - Key: item.place_on_board.name
    Value: Cigarette
  - Key: item.place_on_board.description
    Value: "Posez une de vos cartes face visible sur le board pour que tout le monde
      la voie, et piochez une nouvelle carte dans le paquet \xE0 sa place."
  - Key: item.place_on_board.notice
    Value: "A POS\xC9 UNE CARTE"
  - Key: item.place_on_board.prompt
    Value: "D\xC9SIGNEZ LA CARTE \xC0 POSER SUR LE BOARD"
  - Key: item.raise_stakes.name
    Value: Relance
  - Key: item.raise_stakes.description
    Value: "Chaque mise du prochain tour ajoute un champignon de plus, la v\xF4tre
      comprise."
  - Key: item.raise_stakes.notice
    Value: "MISES AUGMENT\xC9ES"
  - Key: item.random_suit.name
    Value: "D\xE9"
  - Key: item.random_suit.description
    Value: Une de vos cartes garde sa valeur et prend une autre couleur au hasard.
  - Key: item.random_suit.notice
    Value: "A CHANG\xC9 DE COULEUR"
  - Key: item.random_suit.prompt
    Value: "D\xC9SIGNEZ LA CARTE \xC0 MODIFIER"
  - Key: item.rate_shift.name
    Value: Culotte
  - Key: item.rate_shift.description
    Value: 'Choisissez un joueur : son taux d''hallucination augmente ou diminue
      de {0} %, au hasard.'
  - Key: item.rate_shift.raised
    Value: "+{0} % D'HALLUCINATION \xC0"
  - Key: item.rate_shift.lowered
    Value: "-{0} % D'HALLUCINATION \xC0"
  - Key: item.rate_shift.prompt
    Value: "D\xC9SIGNEZ LE JOUEUR DONT VOUS MODIFIEZ L'HALLUCINATION"
  - Key: item.shared_roll.name
    Value: "Bi\xE8re"
  - Key: item.shared_roll.description
    Value: "Vous et un joueur de votre choix faites chacun un Jet de la mort en m\xEAme
      temps, selon votre propre taux d'hallucination."
  - Key: item.shared_roll.notice
    Value: A FAIT UN JET DE LA MORT AVEC
  - Key: item.shared_roll.prompt
    Value: "D\xC9SIGNEZ QUI FAIT UN JET DE LA MORT AVEC VOUS"
  - Key: item.swap_board.name
    Value: Cigarette
  - Key: item.swap_board.description
    Value: "Une carte du board face cach\xE9e est r\xE9v\xE9l\xE9e \xE0 tous, puis
      \xE9chang\xE9e avec l'une de vos cartes. Votre carte reste face visible sur
      le board."
  - Key: item.swap_board.notice
    Value: "A \xC9CHANG\xC9 UNE CARTE DU BOARD"
  - Key: item.swap_board.prompt
    Value: "D\xC9SIGNEZ LA CARTE QUE VOUS METTEZ SUR LE BOARD"
  - Key: item.swap_hand.name
    Value: Couteau
  - Key: item.swap_hand.description
    Value: "\xC9changez une de vos cartes avec un joueur encore dans la donne. Il
      choisit laquelle des siennes donner."
  - Key: item.swap_hand.notice
    Value: "A \xC9CHANG\xC9 AVEC"
  - Key: item.swap_hand.prompt_own
    Value: "D\xC9SIGNEZ LA CARTE QUE VOUS DONNEZ"
  - Key: item.swap_hand.prompt_player
    Value: "D\xC9SIGNEZ AVEC QUI VOUS \xC9CHANGEZ"
  - Key: item.swap_hand.response
    Value: "veut \xE9changer des cartes avec vous : choisissez-en une \xE0 donner"
  - Key: item.table_reveal.name
    Value: "M\xE9gaphone"
  - Key: item.table_reveal.description
    Value: "Chaque joueur encore dans la donne r\xE9v\xE8le une carte au hasard \xE0
      tout le monde ce tour."
  - Key: item.table_reveal.notice
    Value: "A FORC\xC9 TOUT LE MONDE \xC0 R\xC9V\xC9LER UNE CARTE"
  - Key: item.reason.no_time
    Value: "Il ne reste pas assez de temps pour qu'il r\xE9ponde."
